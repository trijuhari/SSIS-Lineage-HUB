                            <MudText Typo="Typo.body2" Style="color: #94a3b8; line-height: 1.6;" Class="mb-4">
                                Query your SSIS catalog in plain English to find package flows, source tables, and transformations.
                            </MudText>
                            <div class="d-flex align-center justify-space-between mt-auto pt-2" style="border-top: 1px solid rgba(255,255,255,0.05);">
                                <span style="font-size: 0.8rem; font-weight: 700; color: #38bdf8;">Query Catalog &rarr;</span>
                                <span style="font-size: 0.75rem; color: #64748b;">Semantic AI Engine</span>
                            </div>
                        </div>
                    </a>
