                            <MudText Typo="Typo.body2" Style="color: #94a3b8; line-height: 1.6;" Class="mb-4">
                                Automatically validates SSIS output schema expectations against target DW definitions to prevent silent breaking changes.
                            </MudText>
                            <div class="d-flex align-center justify-space-between mt-auto pt-2" style="border-top: 1px solid rgba(255,255,255,0.05);">
                                <span style="font-size: 0.8rem; font-weight: 700; color: #fbbf24;">Validate Contracts &rarr;</span>
                                <span style="font-size: 0.75rem; color: #64748b;">Schema Drift Guard</span>
                            </div>
                        </div>
                    </a>
                </MudItem>

                <!-- Module 6: Risk & Change Heatmap -->
                <MudItem xs="12" md="6" lg="4">
                    <a href="/risk-heatmap" style="text-decoration: none; color: inherit;">
                        <div class="module-card" style="--module-color: #f87171;">
                            <div class="d-flex align-center justify-space-between mb-4">
                                <MudAvatar Color="Color.Error" Variant="Variant.Filled" Size="Size.Medium">
                                    <MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment" Size="Size.Small" />
                                </MudAvatar>
                                <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Outlined">Risk Analytics</MudChip>
                            </div>
                            <MudText Typo="Typo.h6" Style="font-weight: 800; color: #f8fafc;" Class="mb-2">Risk Heatmap</MudText>
                            <MudText Typo="Typo.body2" Style="color: #94a3b8; line-height: 1.6;" Class="mb-4">
                                Highlights high-complexity packages, legacy dependencies, and fragile script tasks in your SSIS catalog.
                            </MudText>
                            <div class="d-flex align-center justify-space-between mt-auto pt-2" style="border-top: 1px solid rgba(255,255,255,0.05);">
                                <span style="font-size: 0.8rem; font-weight: 700; color: #f87171;">View Heatmap &rarr;</span>
                                <span style="font-size: 0.75rem; color: #64748b;">Complexity Index</span>
                            </div>
                        </div>
