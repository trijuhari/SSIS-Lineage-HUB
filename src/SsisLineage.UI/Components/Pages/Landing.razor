                </MudItem>

                <!-- Module 7: AI Natural Language Query -->
                <MudItem xs="12" md="6" lg="4">
                    <a href="/nl-query" style="text-decoration: none; color: inherit;">
                        <div class="module-card" style="--module-color: #38bdf8;">
                            <div class="d-flex align-center justify-space-between mb-4">
                                <MudAvatar Color="Color.Info" Variant="Variant.Filled" Size="Size.Medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Small" />
