@page "/"
@using System.IO
@using SsisLineage.UI.Services
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>SSIS Lineage Hub • Enterprise DTSX Discovery & Intelligence</PageTitle>

<div class="hero-glow-container" style="background: #090d16; color: #f8fafc; min-height: 100vh; display: flex; flex-direction: column;">
    
    <!-- ── Top Navigation Header ── -->
    <header class="landing-navbar w-100 px-6 px-md-12 py-3 d-flex align-center justify-space-between">
        <a href="/" class="d-flex align-center gap-3" style="text-decoration: none; color: inherit;">
            <div class="d-flex align-center justify-center" style="background: #0284c7; border-radius: 8px; width: 34px; height: 34px;">
                <MudIcon Icon="@Icons.Material.Filled.Hub" Size="Size.Small" Style="color: white;" />
            </div>
            <div class="d-flex flex-column">
                <MudText Typo="Typo.h6" Style="font-weight: 800; letter-spacing: 0.5px; line-height: 1.1;">
                    SSIS <span style="color: #38bdf8;">LINEAGE</span>
                </MudText>
                <span style="font-size: 0.65rem; color: #64748b; font-weight: 600; letter-spacing: 1px; text-transform: uppercase;">Discovery Hub</span>
            </div>
        </a>

        <!-- Desktop Navigation -->
        <div class="d-none d-md-flex align-center gap-6" style="font-size: 0.875rem; font-weight: 500; color: #94a3b8;">
            <a href="#features" style="color: inherit; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#f8fafc'" onmouseout="this.style.color='#94a3b8'">Capabilities</a>
            <a href="#preview" style="color: inherit; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#f8fafc'" onmouseout="this.style.color='#94a3b8'">Preview</a>
            <a href="#modules" style="color: inherit; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#f8fafc'" onmouseout="this.style.color='#94a3b8'">Modules</a>
            <a href="#exporters" style="color: inherit; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#f8fafc'" onmouseout="this.style.color='#94a3b8'">Exporters</a>
        </div>

        <div class="d-flex align-center gap-3">
            <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Href="/lineage?demo=true" 
                       Style="border-radius: 8px; border-color: rgba(255, 255, 255, 0.15); text-transform: none; font-weight: 600; padding: 6px 16px; color: #cbd5e1;">
                Explore Demo
            </MudButton>
            <MudButton Class="btn-gradient-primary" Variant="Variant.Filled" Href="/lineage" 
                       Style="border-radius: 8px; text-transform: none; font-weight: 600; padding: 6px 20px;">
                Launch Workspace
            </MudButton>
        </div>
    </header>

    <!-- ── Hero Content Section ── -->
    <main class="w-100 px-6 px-md-12 py-12 d-flex flex-column align-center justify-center flex-grow-1" style="max-width: 1280px; margin: 0 auto; z-index: 1;">
        
        <!-- Hero Pill Badge -->
        <div class="mb-6 text-center">
            <div class="badge-pill-glow">
                <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" Style="font-size: 0.9rem; color: #38bdf8;" />
                <span>SSIS DISCOVERY ENGINE • 100% OFFLINE & LOCAL</span>
            </div>
        </div>

        <!-- Main Title -->
        <h1 class="text-center mb-6" style="font-size: 3rem; font-weight: 800; line-height: 1.15; letter-spacing: -0.5px;">
            Enterprise Data Lineage & Intelligence <br />
            <span style="color: #38bdf8;">
                For SQL Server Integration Services
            </span>
        </h1>

        <!-- Subtitle -->
        <p class="text-center mb-8" style="font-size: 1.125rem; color: #94a3b8; max-width: 780px; line-height: 1.6;">
            Extract column-level lineage, stitch cross-package dependencies, resolve database stored procedures, and validate data contracts from DTSX files. Zero Visual Studio runtime dependency.
        </p>

        <!-- CTA Action Buttons -->
        <div class="d-flex gap-4 align-center justify-center flex-wrap mb-14">
            <MudButton Class="btn-gradient-primary" Variant="Variant.Filled" Size="Size.Large" 
                       StartIcon="@Icons.Material.Filled.AccountTree" Href="/lineage" 
                       Style="border-radius: 8px; padding: 12px 28px; font-size: 0.95rem; text-transform: none;">
                Open Interactive Workspace
            </MudButton>

            <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Large" 
                       StartIcon="@Icons.Material.Filled.PlayArrow" Href="/lineage?demo=true" 
                       Style="border-radius: 8px; border: 1px solid rgba(255,255,255,0.15); background: rgba(255,255,255,0.03); padding: 12px 24px; font-weight: 600; text-transform: none; color: #f1f5f9;">
                Load Live Demo Data
            </MudButton>

            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Large" 
                       StartIcon="@Icons.Material.Filled.Psychology" Href="/nl-query" 
                       Style="font-weight: 600; text-transform: none; color: #38bdf8;">
                Try AI Lineage Query &rarr;
            </MudButton>
        </div>

        <!-- ── Key Technical Capabilities Strip ── -->
        <div class="w-100 mb-16" id="features">
            <MudGrid Spacing="4">
                <MudItem xs="12" sm="6" md="3">
                    <div class="stat-box h-100">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Style="color: #38bdf8;" Size="Size.Medium" Class="mb-3" />
                        <MudText Typo="Typo.h6" Style="font-weight: 700; color: #f8fafc;">100% Offline & Private</MudText>
                        <MudText Typo="Typo.body2" Style="color: #94a3b8;" Class="mt-1">
                            Zero cloud calls or telemetry. Code, XML parsing, and SQL parsing run strictly on localhost.
                        </MudText>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <div class="stat-box h-100">
                        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Style="color: #38bdf8;" Size="Size.Medium" Class="mb-3" />
                        <MudText Typo="Typo.h6" Style="font-weight: 700; color: #f8fafc;">Column-Level Precision</MudText>
                        <MudText Typo="Typo.body2" Style="color: #94a3b8;" Class="mt-1">
                            Trace exact source-to-target mappings across transformations, conditional splits, and joins.
                        </MudText>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <div class="stat-box h-100">
                        <MudIcon Icon="@Icons.Material.Filled.Terminal" Style="color: #38bdf8;" Size="Size.Medium" Class="mb-3" />
                        <MudText Typo="Typo.h6" Style="font-weight: 700; color: #f8fafc;">T-SQL AST Resolution</MudText>
                        <MudText Typo="Typo.body2" Style="color: #94a3b8;" Class="mt-1">
                            Parses inline T-SQL, dynamic execution scripts, and database stored procedures.
                        </MudText>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <div class="stat-box h-100">
                        <MudIcon Icon="@Icons.Material.Filled.FileDownload" Style="color: #38bdf8;" Size="Size.Medium" Class="mb-3" />
                        <MudText Typo="Typo.h6" Style="font-weight: 700; color: #f8fafc;">Multi-Format Exporters</MudText>
                        <MudText Typo="Typo.body2" Style="color: #94a3b8;" Class="mt-1">
                            One-click exports to OpenLineage JSON, Cypher graph scripts, Mermaid DAGs, CSV, & YAML.
                        </MudText>
                    </div>
                </MudItem>
            </MudGrid>
        </div>

        <!-- ── Interactive Live Workspace Preview ── -->
        <div class="w-100 mb-16" id="preview">
            <div class="text-center mb-6">
                <MudText Typo="Typo.overline" Style="color: #64748b; font-weight: 700; letter-spacing: 1.5px;">WORKSPACE INTERACTIVE PREVIEW</MudText>
                <MudText Typo="Typo.h4" Style="font-weight: 800;" Class="mt-1">Interactive Data Flow & Lineage Inspection</MudText>
            </div>

            <div class="glass-card pa-6">
                <!-- Toolbar Header -->
                <div class="d-flex align-center justify-space-between flex-wrap gap-4 pb-4 mb-4" style="border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
                    <div class="d-flex align-center gap-2">
                        <div style="width: 10px; height: 10px; border-radius: 50%; background: #64748b;"></div>
                        <div style="width: 10px; height: 10px; border-radius: 50%; background: #64748b;"></div>
                        <div style="width: 10px; height: 10px; border-radius: 50%; background: #64748b;"></div>
                        <span class="ml-3" style="font-size: 0.85rem; color: #94a3b8; font-family: monospace;">Pkg_03_Load_FactSales_DW.dtsx</span>
                    </div>

                    <!-- Interactive Preview Switcher Tabs -->
                    <div class="d-flex gap-2 p-1" style="background: rgba(0, 0, 0, 0.4); border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.08);">
                        <MudButton Class="preview-tab-btn" Size="Size.Small" 
                                   Variant="@(_previewMode == "graph" ? Variant.Filled : Variant.Text)" 
                                   Color="@(_previewMode == "graph" ? Color.Primary : Color.Inherit)"
                                   OnClick='() => _previewMode = "graph"'>
                            Lineage Graph
                        </MudButton>
                        <MudButton Class="preview-tab-btn" Size="Size.Small" 
                                   Variant="@(_previewMode == "narrative" ? Variant.Filled : Variant.Text)" 
                                   Color="@(_previewMode == "narrative" ? Color.Primary : Color.Inherit)"
                                   OnClick='() => _previewMode = "narrative"'>
                            Business Narrative
                        </MudButton>
                        <MudButton Class="preview-tab-btn" Size="Size.Small" 
                                   Variant="@(_previewMode == "contract" ? Variant.Filled : Variant.Text)" 
                                   Color="@(_previewMode == "contract" ? Color.Primary : Color.Inherit)"
                                   OnClick='() => _previewMode = "contract"'>
                            Data Contract
                        </MudButton>
                        <MudButton Class="preview-tab-btn" Size="Size.Small" 
                                   Variant="@(_previewMode == "export" ? Variant.Filled : Variant.Text)" 
                                   Color="@(_previewMode == "export" ? Color.Primary : Color.Inherit)"
                                   OnClick='() => _previewMode = "export"'>
                            Exporters (OpenLineage)
                        </MudButton>
                    </div>
                </div>

                <!-- Preview Content Box -->
                <div style="min-height: 300px; background: #06090e; border-radius: 8px; padding: 24px; border: 1px solid rgba(255, 255, 255, 0.05);" class="d-flex flex-column justify-center">
                    @if (_previewMode == "graph")
                    {
                        <div class="d-flex align-center justify-space-around flex-wrap gap-6 py-4">
                            <!-- Source Node -->
                            <div class="pa-4 glass-card" style="width: 220px; border-left: 3px solid #38bdf8 !important;">
                                <div class="d-flex align-center gap-2 mb-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Storage" Style="color: #38bdf8;" Size="Size.Small" />
                                    <span style="font-size: 0.75rem; font-weight: 700; color: #38bdf8; letter-spacing: 0.5px;">OLEDB SOURCE</span>
                                </div>
                                <div style="font-weight: 700; font-size: 0.9rem; color: #f8fafc;">Sales.SalesOrderDetail</div>
                                <div style="font-size: 0.75rem; color: #94a3b8;" class="mt-1">LineTotal, UnitPrice, OrderQty</div>
                            </div>

                            <!-- Flow Arrow -->
                            <div class="d-flex flex-column align-center">
                                <span style="font-size: 0.75rem; color: #64748b; font-weight: 600;">Data Flow</span>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Style="color: #38bdf8;" />
                            </div>

                            <!-- Transformation Node -->
                            <div class="pa-4 glass-card" style="width: 220px; border-left: 3px solid #0284c7 !important;">
                                <div class="d-flex align-center gap-2 mb-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Functions" Style="color: #0284c7;" Size="Size.Small" />
                                    <span style="font-size: 0.75rem; font-weight: 700; color: #0284c7; letter-spacing: 0.5px;">DERIVED COLUMN</span>
                                </div>
                                <div style="font-weight: 700; font-size: 0.9rem; color: #f8fafc;">CalcNetTotal</div>
                                <div style="font-size: 0.75rem; color: #94a3b8;" class="mt-1">NetTotal = LineTotal * (1 - Discount)</div>
                            </div>

                            <!-- Flow Arrow -->
                            <div class="d-flex flex-column align-center">
                                <span style="font-size: 0.75rem; color: #64748b; font-weight: 600;">Stitched</span>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Style="color: #38bdf8;" />
                            </div>

                            <!-- Destination Node -->
                            <div class="pa-4 glass-card" style="width: 220px; border-left: 3px solid #10b981 !important;">
                                <div class="d-flex align-center gap-2 mb-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Dns" Style="color: #10b981;" Size="Size.Small" />
                                    <span style="font-size: 0.75rem; font-weight: 700; color: #10b981; letter-spacing: 0.5px;">OLEDB DESTINATION</span>
                                </div>
                                <div style="font-weight: 700; font-size: 0.9rem; color: #f8fafc;">dbo.FactSales</div>
                                <div style="font-size: 0.75rem; color: #94a3b8;" class="mt-1">Target DW Table</div>
                            </div>
                        </div>
                    }
                    else if (_previewMode == "narrative")
                    {
                        <div class="pa-4" style="line-height: 1.7; color: #cbd5e1; font-size: 0.95rem;">
                            <div class="d-flex align-center gap-2 mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.Article" Style="color: #38bdf8;" Size="Size.Small" />
                                <span style="font-weight: 700; color: #f8fafc;">Package Executive Summary</span>
                            </div>
                            <p>
                                Package <code>Pkg_03_Load_FactSales_DW.dtsx</code> extracts sales transaction line items from the transactional table <code>Sales.SalesOrderDetail</code>. It applies business logic calculations to compute net total revenue after discounts, resolves foreign keys against <code>DimCustomer</code> and <code>DimProduct</code> via T-SQL procedure resolution, and loads clean records into <code>dbo.FactSales</code>.
                            </p>
                        </div>
                    }
                    else if (_previewMode == "contract")
                    {
                        <div class="pa-4">
                            <div class="d-flex align-center justify-space-between mb-4 pb-2" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color: #10b981;" />
                                    <span style="font-weight: 700; color: #10b981;">Data Contract Validation: PASSING</span>
                                </div>
                                <span style="font-size: 0.8rem; color: #94a3b8;">0 Schema Drift Errors</span>
                            </div>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="4">
                                    <div class="pa-3 glass-card" style="font-size: 0.85rem;">
                                        <div style="color: #94a3b8;">Source Field</div>
                                        <div style="font-weight: 700; color: #38bdf8;">UnitPrice (Decimal 18,4)</div>
                                    </div>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <div class="pa-3 glass-card" style="font-size: 0.85rem;">
                                        <div style="color: #94a3b8;">Transformation</div>
                                        <div style="font-weight: 700; color: #f8fafc;">Pass-through Direct</div>
                                    </div>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <div class="pa-3 glass-card" style="font-size: 0.85rem;">
                                        <div style="color: #94a3b8;">Target Field</div>
                                        <div style="font-weight: 700; color: #10b981;">UnitPrice (Decimal 18,4)</div>
                                    </div>
                                </MudItem>
                            </MudGrid>
                        </div>
                    }
                    else
                    {
                        <div class="code-block-preview">
<pre style="margin: 0;"><code>{
  "$schema": "https://openlineage.io/spec/1-0-2/OpenLineage.json",
  "eventType": "COMPLETE",
  "job": {
    "namespace": "ssis-lineage-hub",
    "name": "Pkg_03_Load_FactSales_DW"
  },
  "inputs": [{ "namespace": "SqlServer", "name": "Sales.SalesOrderDetail" }],
  "outputs": [{ "namespace": "SqlServerDW", "name": "dbo.FactSales" }]
}</code></pre>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ── Lineage Modules Grid ── -->
        <div class="w-100 mb-16" id="modules">
            <div class="text-center mb-10">
                <MudText Typo="Typo.overline" Style="color: #64748b; font-weight: 700; letter-spacing: 1.5px;">INTELLIGENCE MODULES</MudText>
                <MudText Typo="Typo.h4" Style="font-weight: 800;" Class="mt-1">Data Engineering Analysis Suite</MudText>
                <MudText Typo="Typo.body1" Style="color: #94a3b8; max-width: 620px;" Class="mx-auto mt-2">
                    Comprehensive suite for auditing, tracing, simulating, migrating, and validating Microsoft SSIS catalog packages.
                </MudText>
            </div>

            <MudGrid Spacing="4">
                <!-- Module 1: Lineage Workspace -->
                <MudItem xs="12" md="6" lg="4">
                    <a href="/lineage" style="text-decoration: none; color: inherit;">
                        <div class="module-card">
                            <div class="d-flex align-center gap-3 mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Style="color: #38bdf8;" />
                                <MudText Typo="Typo.h6" Style="font-weight: 700; color: #f8fafc;">Cross-Package Lineage</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Style="color: #94a3b8; line-height: 1.6;" Class="mb-4">
                                Visualizes end-to-end DTSX execution dependencies and data flow graphs with interactive zoom, node inspection, and field mapping.
                            </MudText>
                            <div class="d-flex align-center justify-space-between mt-auto pt-3" style="border-top: 1px solid rgba(255,255,255,0.06);">
                                <span style="font-size: 0.8rem; font-weight: 600; color: #38bdf8;">Open Workspace &rarr;</span>
                                <span style="font-size: 0.75rem; color: #64748b;">Cytoscape Canvas</span>
                            </div>
                        </div>
                    </a>
                </MudItem>

                <!-- Module 2: Lineage Search & Trace -->
                <MudItem xs="12" md="6" lg="4">
                    <a href="/lineage-trace" style="text-decoration: none; color: inherit;">
                        <div class="module-card">
                            <div class="d-flex align-center gap-3 mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.Search" Style="color: #38bdf8;" />
                                <MudText Typo="Typo.h6" Style="font-weight: 700; color: #f8fafc;">Column Lineage Trace</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Style="color: #94a3b8; line-height: 1.6;" Class="mb-4">
                                Trace any column upstream or downstream across multi-step pipeline transformations and stored procedure steps.
                            </MudText>
                            <div class="d-flex align-center justify-space-between mt-auto pt-3" style="border-top: 1px solid rgba(255,255,255,0.06);">
                                <span style="font-size: 0.8rem; font-weight: 600; color: #38bdf8;">Trace Column &rarr;</span>
                                <span style="font-size: 0.75rem; color: #64748b;">Field Origin</span>
                            </div>
                        </div>
                    </a>
                </MudItem>

                <!-- Module 3: What-If Impact Simulator -->
                <MudItem xs="12" md="6" lg="4">
                    <a href="/what-if" style="text-decoration: none; color: inherit;">
                        <div class="module-card">
                            <div class="d-flex align-center gap-3 mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.Science" Style="color: #38bdf8;" />
                                <MudText Typo="Typo.h6" Style="font-weight: 700; color: #f8fafc;">What-If Simulator</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Style="color: #94a3b8; line-height: 1.6;" Class="mb-4">
                                Predict the downstream ripple effect of renaming columns or changing data types before altering production DTSX packages.
                            </MudText>
                            <div class="d-flex align-center justify-space-between mt-auto pt-3" style="border-top: 1px solid rgba(255,255,255,0.06);">
                                <span style="font-size: 0.8rem; font-weight: 600; color: #38bdf8;">Simulate Changes &rarr;</span>
                                <span style="font-size: 0.75rem; color: #64748b;">Impact Analysis</span>
                            </div>
                        </div>
                    </a>
                </MudItem>

                <!-- Module 4: Data Quality Propagation -->
                <MudItem xs="12" md="6" lg="4">
                    <a href="/quality-propagation" style="text-decoration: none; color: inherit;">
                        <div class="module-card">
                            <div class="d-flex align-center gap-3 mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Style="color: #38bdf8;" />
                                <MudText Typo="Typo.h6" Style="font-weight: 700; color: #f8fafc;">Quality Propagation</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Style="color: #94a3b8; line-height: 1.6;" Class="mb-4">
                                Tracks quality decay scores and trust metrics through lookup joins, conditional splits, and destination tables.
                            </MudText>
                            <div class="d-flex align-center justify-space-between mt-auto pt-3" style="border-top: 1px solid rgba(255,255,255,0.06);">
                                <span style="font-size: 0.8rem; font-weight: 600; color: #38bdf8;">Quality Tracking &rarr;</span>
                                <span style="font-size: 0.75rem; color: #64748b;">Trust Score</span>
                            </div>
                        </div>
                    </a>
                </MudItem>

                <!-- Module 5: Data Contract Validator -->
                <MudItem xs="12" md="6" lg="4">
                    <a href="/data-contracts" style="text-decoration: none; color: inherit;">
                        <div class="module-card">
                            <div class="d-flex align-center gap-3 mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.Description" Style="color: #38bdf8;" />
                                <MudText Typo="Typo.h6" Style="font-weight: 700; color: #f8fafc;">Data Contracts</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Style="color: #94a3b8; line-height: 1.6;" Class="mb-4">
                                Automatically validates output schemas against data warehouse contracts to catch breaking changes early.
                            </MudText>
                            <div class="d-flex align-center justify-space-between mt-auto pt-3" style="border-top: 1px solid rgba(255,255,255,0.06);">
                                <span style="font-size: 0.8rem; font-weight: 600; color: #38bdf8;">Validate Contracts &rarr;</span>
                                <span style="font-size: 0.75rem; color: #64748b;">Schema Guard</span>
                            </div>
                        </div>
                    </a>
                </MudItem>

                <!-- Module 6: Risk Scorer -->
                <MudItem xs="12" md="6" lg="4">
                    <a href="/risk-heatmap" style="text-decoration: none; color: inherit;">
                        <div class="module-card">
                            <div class="d-flex align-center gap-3 mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment" Style="color: #38bdf8;" />
                                <MudText Typo="Typo.h6" Style="font-weight: 700; color: #f8fafc;">Risk Scorer & Heatmap</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Style="color: #94a3b8; line-height: 1.6;" Class="mb-4">
                                Highlights high-complexity packages, fragile script tasks, and unanchored queries across your catalog.
                            </MudText>
                            <div class="d-flex align-center justify-space-between mt-auto pt-3" style="border-top: 1px solid rgba(255,255,255,0.06);">
                                <span style="font-size: 0.8rem; font-weight: 600; color: #38bdf8;">View Heatmap &rarr;</span>
