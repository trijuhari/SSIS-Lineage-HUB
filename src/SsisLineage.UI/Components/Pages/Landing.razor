                            <MudText Typo="Typo.h6" Style="font-weight: 800; color: #f8fafc;" Class="mb-2">DTSX XML Inspector</MudText>
                            <MudText Typo="Typo.body2" Style="color: #94a3b8; line-height: 1.6;" Class="mb-4">
