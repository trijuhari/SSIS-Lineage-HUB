                <MudGrid Spacing="6" Class="align-center">
                    <MudItem xs="12" md="6">
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Text" Class="font-weight-bold mb-2">
                            OPEN STANDARDS & INTEGRATIONS
                        </MudChip>
                        <MudText Typo="Typo.h4" Style="font-weight: 800;" Class="mb-3">Export Lineage Anywhere</MudText>
                        <MudText Typo="Typo.body1" Style="color: #94a3b8; line-height: 1.7;" Class="mb-6">
                            Export your SSIS data lineage graph into industry standard formats for enterprise data catalogs, documentation, and graph databases.
                        </MudText>
                        <div class="d-flex flex-wrap gap-2">
                            <MudChip T="string" Variant="Variant.Filled" Color="Color.Dark" Style="border: 1px solid rgba(56,189,248,0.3); color: #38bdf8;">OpenLineage JSON</MudChip>
                            <MudChip T="string" Variant="Variant.Filled" Color="Color.Dark" Style="border: 1px solid rgba(167,139,250,0.3); color: #a78bfa;">Mermaid.js Diagram</MudChip>
                            <MudChip T="string" Variant="Variant.Filled" Color="Color.Dark" Style="border: 1px solid rgba(74,222,128,0.3); color: #4ade80;">Neo4j Cypher</MudChip>
                            <MudChip T="string" Variant="Variant.Filled" Color="Color.Dark" Style="border: 1px solid rgba(251,191,36,0.3); color: #fbbf24;">Markdown Specs</MudChip>
                            <MudChip T="string" Variant="Variant.Filled" Color="Color.Dark" Style="border: 1px solid rgba(248,113,113,0.3); color: #f87171;">YAML Manifests</MudChip>
                        </div>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <div class="sql-code-card">
                            <div class="sql-code-card-header">
                                <span class="sql-card-title">CLI Quick Exporter Command</span>
                                <MudButton Class="sql-card-copy-btn" Size="Size.Small" Variant="Variant.Outlined" OnClick="CopyCliCommand">
                                    @(_copiedCli ? "Copied!" : "Copy Command")
                                </MudButton>
                            </div>
                            <div class="sql-code-card-body">
                                <pre class="sql-code-editor"><code>$ dotnet ssis-lineage parse ./samples \
    --format openlineage \
    --output ./lineage-export.json \
    --include-procedures</code></pre>
                            </div>
                        </div>
                    </MudItem>
                </MudGrid>
            </div>
        </div>

        <!-- ── System Specs & Architecture ── -->
        <div class="w-100 mb-16 animate-fade-in" style="animation-delay: 0.55s;" id="architecture">
            <div class="glass-card pa-8" style="border: 1px solid rgba(255, 255, 255, 0.06);">
                <MudText Typo="Typo.h5" Style="font-weight: 800;" Class="mb-6">Technical Architecture & Engine Specifications</MudText>
                <MudGrid Spacing="4">
                    <MudItem xs="12" sm="6" md="3">
                        <div class="d-flex align-center gap-3 mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Speed" Color="Color.Primary" />
                            <span style="font-weight: 700; color: #f8fafc;">Core Engine</span>
                        </div>
                        <p style="font-size: 0.85rem; color: #94a3b8; line-height: 1.5;">
