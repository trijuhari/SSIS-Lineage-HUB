</div>

<style>
    .hero-title {
        font-size: 3.4rem;
        font-weight: 900;
        line-height: 1.15;
        letter-spacing: -1px;
    }
    
    @@media (max-width: 768px) {
        .hero-title {
            font-size: 2.2rem;
        }
    }

    .hero-subtitle {
        font-size: 1.2rem;
        max-width: 780px;
        line-height: 1.6;
        font-weight: 300;
        color: #cbd5e1;
    }
</style>

@code {
    private string _previewMode = "graph";
    private bool _copiedCli = false;

    private async Task CopyCliCommand()
    {
        _copiedCli = true;
        Snackbar.Add("CLI command copied to clipboard!", Severity.Success);
        await Task.Delay(2500);
        _copiedCli = false;
        StateHasChanged();
    }
}

