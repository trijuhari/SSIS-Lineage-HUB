@page "/"
@using System.IO
@using SsisLineage.UI.Services
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>SSIS Lineage Hub • Enterprise DTSX Discovery & Intelligence</PageTitle>

<div class="hero-glow-container" style="background: radial-gradient(circle at 50% 0%, #0f172a 0%, #080d1a 100%); color: #f8fafc; min-height: 100vh; display: flex; flex-direction: column;">
    
    <!-- Background Animated Gradient Orbs -->
    <div class="hero-glow-orb-1"></div>
    <div class="hero-glow-orb-2"></div>

    <!-- ── Top Navigation Header ── -->
    <header class="landing-navbar w-100 px-6 px-md-12 py-3 d-flex align-center justify-space-between">
        <a href="/" class="d-flex align-center gap-3" style="text-decoration: none; color: inherit;">
            <div class="d-flex align-center justify-center" style="background: linear-gradient(135deg, #0284c7 0%, #38bdf8 50%, #818cf8 100%); border-radius: 10px; width: 38px; height: 38px; box-shadow: 0 4px 14px rgba(56, 189, 248, 0.35);">
                <MudIcon Icon="@Icons.Material.Filled.Hub" Size="Size.Medium" Style="color: white;" />
            </div>
            <div class="d-flex flex-column">
                <MudText Typo="Typo.h6" Style="font-weight: 900; letter-spacing: 0.5px; line-height: 1.1;">
                    SSIS <span style="background: linear-gradient(90deg, #38BDF8 0%, #818CF8 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">LINEAGE</span>
                </MudText>
                <span style="font-size: 0.65rem; color: #94a3b8; font-weight: 600; letter-spacing: 1px; text-transform: uppercase;">Enterprise Intelligence Hub</span>
            </div>
        </a>

        <!-- Desktop Links -->
        <div class="d-none d-md-flex align-center gap-6" style="font-size: 0.9rem; font-weight: 600; color: #cbd5e1;">
            <a href="#features" style="color: inherit; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#38bdf8'" onmouseout="this.style.color='#cbd5e1'">Capabilities</a>
            <a href="#modules" style="color: inherit; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#38bdf8'" onmouseout="this.style.color='#cbd5e1'">Modules</a>
            <a href="#exporters" style="color: inherit; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#38bdf8'" onmouseout="this.style.color='#cbd5e1'">Integrations</a>
            <a href="#architecture" style="color: inherit; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#38bdf8'" onmouseout="this.style.color='#cbd5e1'">Architecture</a>
        </div>

        <div class="d-flex align-center gap-3">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/lineage?demo=true" 
                       Style="border-radius: 10px; border-color: rgba(167, 139, 250, 0.4); text-transform: none; font-weight: 600; padding: 6px 16px;">
                Explore Demo
            </MudButton>
            <MudButton Class="btn-gradient-primary" Variant="Variant.Filled" Href="/lineage" 
                       Style="border-radius: 10px; text-transform: none; font-weight: 700; padding: 6px 20px;">
                Launch Workspace
            </MudButton>
        </div>
    </header>

    <!-- ── Hero Content Section ── -->
    <main class="w-100 px-6 px-md-12 py-10 d-flex flex-column align-center justify-center flex-grow-1" style="max-width: 1320px; margin: 0 auto; z-index: 1;">
        
        <!-- Hero Badge -->
        <div class="animate-fade-in mb-6 text-center">
            <div class="badge-pill-glow">
                <span class="pulse-dot"></span>
                <span>SSIS DISCOVERY ENGINE v2026 • 100% OFFLINE & SECURE</span>
            </div>
        </div>

        <!-- Main Title -->
        <h1 class="text-center hero-title mb-6 animate-fade-in" style="animation-delay: 0.1s;">
            Enterprise Data Lineage & Intelligence <br />
            <span style="background: linear-gradient(135deg, #38BDF8 0%, #a78bfa 50%, #f472b6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                For SQL Server Integration Services
            </span>
        </h1>

        <!-- Subtitle -->
        <p class="text-center hero-subtitle mb-8 animate-fade-in" style="animation-delay: 0.2s;">
            Instant column-level lineage extraction, cross-package stitching, automated data contract validation, and natural language business narratives for DTSX packages. Zero Visual Studio dependency.
        </p>

        <!-- CTA Action Buttons -->
        <div class="d-flex gap-4 align-center justify-center flex-wrap mb-14 animate-fade-in" style="animation-delay: 0.3s;">
            <MudButton Class="btn-gradient-primary" Variant="Variant.Filled" Size="Size.Large" 
                       StartIcon="@Icons.Material.Filled.RocketLaunch" Href="/lineage" 
                       Style="border-radius: 12px; padding: 14px 32px; font-size: 1rem;">
                Open Interactive Workspace
            </MudButton>

            <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Large" 
                       StartIcon="@Icons.Material.Filled.PlayCircleFilled" Href="/lineage?demo=true" 
                       Style="border-radius: 12px; border: 1px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.03); padding: 14px 28px; font-weight: 600; text-transform: none;">
                Load Live Demo Data
            </MudButton>

            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Large" 
                       StartIcon="@Icons.Material.Filled.AutoAwesome" Href="/nl-query" 
                       Style="font-weight: 600; text-transform: none;">
                Try AI Lineage Query &rarr;
            </MudButton>
        </div>

        <!-- ── Key Stats Strip ── -->
        <div class="w-100 mb-14 animate-fade-in" style="animation-delay: 0.35s;" id="features">
            <MudGrid Spacing="4">
                <MudItem xs="6" sm="3">
                    <div class="stat-box h-100">
                        <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Primary" Size="Size.Medium" Class="mb-2" />
                        <MudText Typo="Typo.h4" Style="font-weight: 900; color: #38bdf8;">100%</MudText>
                        <MudText Typo="Typo.body2" Style="color: #94a3b8; font-weight: 600;" Class="mt-1">Private & Offline</MudText>
                        <span style="font-size: 0.75rem; color: #64748b;">Credentials & code stay local</span>
                    </div>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <div class="stat-box h-100">
                        <MudIcon Icon="@Icons.Material.Filled.FlashOn" Color="Color.Secondary" Size="Size.Medium" Class="mb-2" />
                        <MudText Typo="Typo.h4" Style="font-weight: 900; color: #a78bfa;">0 Sec</MudText>
                        <MudText Typo="Typo.body2" Style="color: #94a3b8; font-weight: 600;" Class="mt-1">VS / SSDT Dependency</MudText>
                        <span style="font-size: 0.75rem; color: #64748b;">Instant XML parsing engine</span>
                    </div>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <div class="stat-box h-100">
                        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Success" Size="Size.Medium" Class="mb-2" />
                        <MudText Typo="Typo.h4" Style="font-weight: 900; color: #4ade80;">Column</MudText>
                        <MudText Typo="Typo.body2" Style="color: #94a3b8; font-weight: 600;" Class="mt-1">Level Precision</MudText>
                        <span style="font-size: 0.75rem; color: #64748b;">Source-to-target field tracing</span>
                    </div>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <div class="stat-box h-100">
                        <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Warning" Size="Size.Medium" Class="mb-2" />
                        <MudText Typo="Typo.h4" Style="font-weight: 900; color: #fbbf24;">10 Suite</MudText>
                        <MudText Typo="Typo.body2" Style="color: #94a3b8; font-weight: 600;" Class="mt-1">Lineage Modules</MudText>
                        <span style="font-size: 0.75rem; color: #64748b;">Contract, What-If, Quality, AI</span>
                    </div>
                </MudItem>
            </MudGrid>
        </div>

        <!-- ── Interactive Live Preview Mockup ── -->
        <div class="w-100 mb-16 animate-fade-in" style="animation-delay: 0.4s;" id="preview">
            <div class="text-center mb-6">
                <MudChip T="string" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="font-weight-bold" Style="letter-spacing: 1.5px;">
                    WORKSPACE INTERACTIVE PREVIEW
                </MudChip>
                <MudText Typo="Typo.h4" Style="font-weight: 800;" Class="mt-1">See How SSIS Lineage Hub Maps Your ETL</MudText>
            </div>

            <div class="glass-card pa-6" style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.12); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);">
                <!-- Toolbar Header -->
                <div class="d-flex align-center justify-space-between flex-wrap gap-4 pb-4 mb-4" style="border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
                    <div class="d-flex align-center gap-2">
                        <div style="width: 12px; height: 12px; border-radius: 50%; background: #ef4444;"></div>
                        <div style="width: 12px; height: 12px; border-radius: 50%; background: #f59e0b;"></div>
                        <div style="width: 12px; height: 12px; border-radius: 50%; background: #10b981;"></div>
                        <span class="ml-3 font-weight-bold" style="font-size: 0.85rem; color: #94a3b8; font-family: monospace;">Pkg_03_Load_FactSales_DW.dtsx</span>
                    </div>

                    <!-- Interactive Preview Switcher Tabs -->
                    <div class="d-flex gap-2 p-1" style="background: rgba(0, 0, 0, 0.3); border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.05);">
                        <MudButton Class="preview-tab-btn" Size="Size.Small" 
                                   Variant="@(_previewMode == "graph" ? Variant.Filled : Variant.Text)" 
                                   Color="@(_previewMode == "graph" ? Color.Primary : Color.Inherit)"
                                   OnClick='() => _previewMode = "graph"'>
                            Lineage Graph
                        </MudButton>
                        <MudButton Class="preview-tab-btn" Size="Size.Small" 
                                   Variant="@(_previewMode == "narrative" ? Variant.Filled : Variant.Text)" 
                                   Color="@(_previewMode == "narrative" ? Color.Secondary : Color.Inherit)"
                                   OnClick='() => _previewMode = "narrative"'>
                            Business Narrative
                        </MudButton>
                        <MudButton Class="preview-tab-btn" Size="Size.Small" 
                                   Variant="@(_previewMode == "contract" ? Variant.Filled : Variant.Text)" 
                                   Color="@(_previewMode == "contract" ? Color.Success : Color.Inherit)"
                                   OnClick='() => _previewMode = "contract"'>
                            Data Contract
                        </MudButton>
                        <MudButton Class="preview-tab-btn" Size="Size.Small" 
                                   Variant="@(_previewMode == "export" ? Variant.Filled : Variant.Text)" 
                                   Color="@(_previewMode == "export" ? Color.Warning : Color.Inherit)"
                                   OnClick='() => _previewMode = "export"'>
                            Exporters (OpenLineage)
                        </MudButton>
                    </div>
                </div>

                <!-- Preview Content Box -->
                <div style="min-height: 320px; background: rgba(9, 13, 22, 0.6); border-radius: 12px; padding: 24px;" class="d-flex flex-column justify-center">
                    @if (_previewMode == "graph")
                    {
                        <div class="d-flex align-center justify-space-around flex-wrap gap-6 py-4">
                            <!-- Source Node -->
                            <div class="pa-4 glass-card" style="width: 220px; border-left: 4px solid #38bdf8 !important;">
                                <div class="d-flex align-center gap-2 mb-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Info" Size="Size.Small" />
                                    <span style="font-size: 0.8rem; font-weight: 700; color: #38bdf8;">OLEDB SOURCE</span>
                                </div>
                                <div style="font-weight: 700; font-size: 0.95rem;">Sales.SalesOrderDetail</div>
                                <div style="font-size: 0.75rem; color: #94a3b8;" class="mt-1">Cols: LineTotal, UnitPrice, OrderQty</div>
                            </div>

                            <!-- Flow Arrow -->
                            <div class="d-flex flex-column align-center">
                                <span style="font-size: 0.75rem; color: #38bdf8; font-weight: 700;">Data Flow</span>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Color="Color.Primary" />
                            </div>

                            <!-- Transform Node -->
                            <div class="pa-4 glass-card" style="width: 220px; border-left: 4px solid #a78bfa !important;">
                                <div class="d-flex align-center gap-2 mb-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Functions" Color="Color.Secondary" Size="Size.Small" />
                                    <span style="font-size: 0.8rem; font-weight: 700; color: #a78bfa;">DERIVED COLUMN</span>
                                </div>
                                <div style="font-weight: 700; font-size: 0.95rem;">CalcNetTotal</div>
                                <div style="font-size: 0.75rem; color: #94a3b8;" class="mt-1">NetTotal = LineTotal * (1 - Discount)</div>
                            </div>

                            <!-- Flow Arrow -->
                            <div class="d-flex flex-column align-center">
                                <span style="font-size: 0.75rem; color: #a78bfa; font-weight: 700;">Stitched</span>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Color="Color.Secondary" />
                            </div>

                            <!-- Destination Node -->
                            <div class="pa-4 glass-card" style="width: 220px; border-left: 4px solid #4ade80 !important;">
                                <div class="d-flex align-center gap-2 mb-2">
                                    <MudIcon Icon="@Icons.Material.Filled.TableChart" Color="Color.Success" Size="Size.Small" />
                                    <span style="font-size: 0.8rem; font-weight: 700; color: #4ade80;">OLEDB DESTINATION</span>
                                </div>
                                <div style="font-weight: 700; font-size: 0.95rem;">dbo.FactSales</div>
                                <div style="font-size: 0.75rem; color: #94a3b8;" class="mt-1">Target Schema: DW_Sales</div>
                            </div>
                        </div>
                    }
                    else if (_previewMode == "narrative")
                    {
                        <div class="pa-4" style="font-size: 0.95rem; line-height: 1.7; color: #e2e8f0;">
                            <div class="d-flex align-center gap-2 mb-3">
                                <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Filled">NARRATIVE ENGINE (EN)</MudChip>
                                <span style="font-weight: 700; color: #a78bfa;">SSIS Package Execution Narrative Summary</span>
                            </div>
                            <p class="mb-3">
                                📌 <strong>Pipeline Overview:</strong> Package <code>Pkg_03_Load_FactSales_DW.dtsx</code> extracts source records from OLTP table <code>Sales.SalesOrderDetail</code>.
                            </p>
                            <p class="mb-3">
                                ⚙️ <strong>Column Transformations:</strong> Computes net transaction values via the <code>Derived Column (CalcNetTotal)</code> component using expression <code>LineTotal * (1.0 - Discount)</code>.
                            </p>
                            <p>
                                🎯 <strong>Target Destination:</strong> Transformed dataset is loaded directly into target Data Warehouse table <code>dbo.FactSales</code> with data type casting from <code>MONEY</code> to <code>DECIMAL(18,2)</code>.
                            </p>
                        </div>
                    }
                    else if (_previewMode == "contract")
                    {
                        <div class="pa-4">
                            <div class="d-flex align-center justify-space-between mb-4">
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Verified" Color="Color.Success" />
                                    <span style="font-weight: 700; color: #4ade80;">Data Contract Status: VERIFIED & PASSING</span>
                                </div>
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">0 Schema Drift Errors</MudChip>
                            </div>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="4">
                                    <div class="pa-3 glass-card" style="font-size: 0.85rem;">
                                        <div style="color: #94a3b8;">Source Column</div>
                                        <div style="font-weight: 700; color: #38bdf8;">UnitPrice (Decimal 18,4)</div>
                                    </div>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <div class="pa-3 glass-card" style="font-size: 0.85rem;">
                                        <div style="color: #94a3b8;">Transformation</div>
                                        <div style="font-weight: 700; color: #a78bfa;">Pass-through Direct</div>
                                    </div>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <div class="pa-3 glass-card" style="font-size: 0.85rem;">
                                        <div style="color: #94a3b8;">Target Column</div>
                                        <div style="font-weight: 700; color: #4ade80;">UnitPrice (Decimal 18,4)</div>
                                    </div>
                                </MudItem>
                            </MudGrid>
                        </div>
                    }
                    else
                    {
                        <div class="code-block-preview">
<pre style="margin: 0;"><code>{
  "$schema": "https://openlineage.io/spec/1-0-2/OpenLineage.json",
  "eventType": "COMPLETE",
  "job": {
    "namespace": "ssis-lineage-hub",
    "name": "Pkg_03_Load_FactSales_DW"
  },
  "inputs": [{ "namespace": "SqlServer", "name": "Sales.SalesOrderDetail" }],
  "outputs": [{ "namespace": "SqlServerDW", "name": "dbo.FactSales" }]
}</code></pre>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ── 10 Specialized Lineage Modules Grid ── -->
        <div class="w-100 mb-16 animate-fade-in" style="animation-delay: 0.45s;" id="modules">
            <div class="text-center mb-10">
                <MudChip T="string" Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small" Class="font-weight-bold" Style="letter-spacing: 1.5px;">
                    COMPLETE INTELLIGENCE SUITE
                </MudChip>
                <MudText Typo="Typo.h3" Style="font-weight: 900;" Class="mt-1">10 Powerful Modules for Every Data Engineering Task</MudText>
                <MudText Typo="Typo.body1" Style="color: #94a3b8; max-width: 650px;" Class="mx-auto mt-2">
                    Everything you need to audit, document, simulate, migrate, and validate SSIS packages in one unified platform.
                </MudText>
            </div>

            <MudGrid Spacing="6">
                <!-- Module 1: Lineage Workspace -->
                <MudItem xs="12" md="6" lg="4">
                    <a href="/lineage" style="text-decoration: none; color: inherit;">
                        <div class="module-card" style="--module-color: #38bdf8;">
                            <div class="d-flex align-center justify-space-between mb-4">
                                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Hub" Size="Size.Small" />
                                </MudAvatar>
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">Core Feature</MudChip>
                            </div>
                            <MudText Typo="Typo.h6" Style="font-weight: 800; color: #f8fafc;" Class="mb-2">Cross-Package Lineage</MudText>
                            <MudText Typo="Typo.body2" Style="color: #94a3b8; line-height: 1.6;" Class="mb-4">
                                Visualizes end-to-end DTSX execution dependencies and data flow graphs with interactive zoom, filtering, and node inspector.
                            </MudText>
                            <div class="d-flex align-center justify-space-between mt-auto pt-2" style="border-top: 1px solid rgba(255,255,255,0.05);">
                                <span style="font-size: 0.8rem; font-weight: 700; color: #38bdf8;">Open Workspace &rarr;</span>
                                <span style="font-size: 0.75rem; color: #64748b;">Cytoscape.js Canvas</span>
                            </div>
                        </div>
                    </a>
                </MudItem>

                <!-- Module 2: Lineage Search & Trace -->
                <MudItem xs="12" md="6" lg="4">
                    <a href="/lineage/trace" style="text-decoration: none; color: inherit;">
                        <div class="module-card" style="--module-color: #a78bfa;">
                            <div class="d-flex align-center justify-space-between mb-4">
                                <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Medium">
                                    <MudIcon Icon="@Icons.Material.Filled.AltRoute" Size="Size.Small" />
                                </MudAvatar>
                                <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Outlined">Traceability</MudChip>
                            </div>
                            <MudText Typo="Typo.h6" Style="font-weight: 800; color: #f8fafc;" Class="mb-2">Column Lineage Trace</MudText>
                            <MudText Typo="Typo.body2" Style="color: #94a3b8; line-height: 1.6;" Class="mb-4">
                                Trace any column upstream or downstream across complex multi-step transformations and database stored procedures.
                            </MudText>
                            <div class="d-flex align-center justify-space-between mt-auto pt-2" style="border-top: 1px solid rgba(255,255,255,0.05);">
                                <span style="font-size: 0.8rem; font-weight: 700; color: #a78bfa;">Trace Column &rarr;</span>
                                <span style="font-size: 0.75rem; color: #64748b;">Field-Level Precision</span>
                            </div>
                        </div>
                    </a>
                </MudItem>

                <!-- Module 3: What-If Impact Simulator -->
                <MudItem xs="12" md="6" lg="4">
                    <a href="/simulator" style="text-decoration: none; color: inherit;">
                        <div class="module-card" style="--module-color: #f472b6;">
                            <div class="d-flex align-center justify-space-between mb-4">
                                <MudAvatar Style="background-color: #f472b6; color: white;" Variant="Variant.Filled" Size="Size.Medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Science" Size="Size.Small" />
                                </MudAvatar>
                                <MudChip T="string" Style="color: #f472b6; border-color: rgba(244,114,182,0.4);" Size="Size.Small" Variant="Variant.Outlined">Simulation</MudChip>
                            </div>
                            <MudText Typo="Typo.h6" Style="font-weight: 800; color: #f8fafc;" Class="mb-2">What-If Impact Simulator</MudText>
                            <MudText Typo="Typo.body2" Style="color: #94a3b8; line-height: 1.6;" Class="mb-4">
                                Predict the ripple effect of renaming columns or altering database schemas before modifying production DTSX files.
                            </MudText>
                            <div class="d-flex align-center justify-space-between mt-auto pt-2" style="border-top: 1px solid rgba(255,255,255,0.05);">
                                <span style="font-size: 0.8rem; font-weight: 700; color: #f472b6;">Simulate Changes &rarr;</span>
                                <span style="font-size: 0.75rem; color: #64748b;">Blast Radius Analytics</span>
                            </div>
                        </div>
                    </a>
                </MudItem>

                <!-- Module 4: Data Quality Propagation -->
                <MudItem xs="12" md="6" lg="4">
                    <a href="/quality-propagation" style="text-decoration: none; color: inherit;">
                        <div class="module-card" style="--module-color: #4ade80;">
                            <div class="d-flex align-center justify-space-between mb-4">
                                <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Medium">
                                    <MudIcon Icon="@Icons.Material.Filled.HighQuality" Size="Size.Small" />
                                </MudAvatar>
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">Governance</MudChip>
                            </div>
                            <MudText Typo="Typo.h6" Style="font-weight: 800; color: #f8fafc;" Class="mb-2">Data Quality Tracking</MudText>
                            <MudText Typo="Typo.body2" Style="color: #94a3b8; line-height: 1.6;" Class="mb-4">
                                Propagates quality scores and trust metrics through lookup joins, conditional splits, and destination tables.
                            </MudText>
                            <div class="d-flex align-center justify-space-between mt-auto pt-2" style="border-top: 1px solid rgba(255,255,255,0.05);">
                                <span style="font-size: 0.8rem; font-weight: 700; color: #4ade80;">Quality Monitor &rarr;</span>
                                <span style="font-size: 0.75rem; color: #64748b;">Trust Score Decay</span>
                            </div>
                        </div>
                    </a>
                </MudItem>

                <!-- Module 5: Data Contract Validator -->
