                        </p>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <div class="d-flex align-center gap-3 mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Translate" Color="Color.Warning" />
                            <span style="font-weight: 700; color: #f8fafc;">Narrative Engine</span>
                        </div>
                        <p style="font-size: 0.85rem; color: #94a3b8; line-height: 1.5;">
