                            <div class="d-flex align-center justify-space-between mt-auto pt-2" style="border-top: 1px solid rgba(255,255,255,0.05);">
                                <span style="font-size: 0.8rem; font-weight: 700; color: #22d3ee;">Inspect DTSX &rarr;</span>
                                <span style="font-size: 0.75rem; color: #64748b;">XML Tree Viewer</span>
                            </div>
                        </div>
