            <div class="d-flex align-center gap-3">
                <div class="d-flex align-center justify-center" style="background: linear-gradient(135deg, #0284c7, #818cf8); border-radius: 8px; width: 28px; height: 28px;">
                    <MudIcon Icon="@Icons.Material.Filled.Hub" Size="Size.Small" Style="color: white;" />
