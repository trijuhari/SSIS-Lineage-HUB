            <MudText Typo="Typo.h4" Style="font-weight: 900; color: #ffffff;" Class="mb-3">
                Ready to Discover Your SSIS Data Lineage?
            </MudText>
            <MudText Typo="Typo.body1" Style="color: #cbd5e1; max-width: 600px;" Class="mx-auto mb-6">
                Start scanning your `.dtsx` packages and SQL databases in seconds with zero cloud setup or server installation.
            </MudText>
            <div class="d-flex align-center justify-center gap-4 flex-wrap">
                <MudButton Class="btn-gradient-primary" Variant="Variant.Filled" Size="Size.Large" 
                           StartIcon="@Icons.Material.Filled.RocketLaunch" Href="/lineage" 
                           Style="border-radius: 12px; padding: 12px 32px;">
                    Launch Workspace Now
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Large" 
                           StartIcon="@Icons.Material.Filled.PlayCircle" Href="/lineage?demo=true" 
                           Style="border-radius: 12px; border-color: rgba(255,255,255,0.3); padding: 12px 28px;">
                    Try Demo Project
