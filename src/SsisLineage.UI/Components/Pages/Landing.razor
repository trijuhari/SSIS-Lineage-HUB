                            <div class="d-flex align-center justify-space-between mt-auto pt-2" style="border-top: 1px solid rgba(255,255,255,0.05);">
                                <span style="font-size: 0.8rem; font-weight: 700; color: #a78bfa;">Migrate Code &rarr;</span>
                                <span style="font-size: 0.75rem; color: #64748b;">dbt / Spark Exporter</span>
                            </div>
                        </div>
                    </a>
                </MudItem>
            </MudGrid>
        </div>

