                            <div class="d-flex align-center justify-space-between mb-4">
                                <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Transform" Size="Size.Small" />
