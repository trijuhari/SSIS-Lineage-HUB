@page "/ssis-migrator"
@using SsisLineage.Core
@using SsisLineage.Core.Models
@using SsisLineage.UI.Services
@inject LineageService LineageService
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>SSIS Code Migrator — SSIS Lineage Hub</PageTitle>

<div class="mb-4 d-flex align-center justify-space-between flex-wrap gap-4">
    <div>
        <MudText Typo="Typo.h5" Class="d-flex align-center gap-2 font-weight-bold">
            <MudIcon Icon="@Icons.Material.Filled.Transform" Color="Color.Primary" Size="Size.Large" />
            SSIS Code Migrator & Modernization Engine
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Automatically convert SSIS packages (.dtsx) into dbt SQL Models, Databricks PySpark, Apache Airflow DAGs, Azure Data Factory (ADF), or SQL Stored Procedures.
        </MudText>
    </div>
    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Style="font-weight:700;">CLOUD MODERNIZATION</MudChip>
</div>

<!-- Configuration Cards -->
<MudGrid Class="mb-6">
    <MudItem xs="12" sm="6" md="4">
        <div Class="pa-4 mud-paper mud-elevation-2"
             style="@GetCardStyle(MigrationTarget.DbtSql)"
             @onclick="() => SelectTarget(MigrationTarget.DbtSql)">
            <div class="d-flex align-center justify-space-between mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Layers" Color="Color.Warning" Size="Size.Large" />
                @if (_selectedTarget == MigrationTarget.DbtSql)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Warning" Size="Size.Medium" />
                }
            </div>
            <MudText Typo="Typo.h6" Class="font-weight-bold">dbt SQL Models</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Generate modular schema.yml & CTE dbt models for Snowflake/BigQuery/Databricks.</MudText>
        </div>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <div Class="pa-4 mud-paper mud-elevation-2"
             style="@GetCardStyle(MigrationTarget.PySpark)"
             @onclick="() => SelectTarget(MigrationTarget.PySpark)">
            <div class="d-flex align-center justify-space-between mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Code" Color="Color.Info" Size="Size.Large" />
                @if (_selectedTarget == MigrationTarget.PySpark)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Info" Size="Size.Medium" />
                }
            </div>
            <MudText Typo="Typo.h6" Class="font-weight-bold">Databricks PySpark</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Generate Python PySpark DataFrame scripts with Delta Lake writers.</MudText>
        </div>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <div Class="pa-4 mud-paper mud-elevation-2"
             style="@GetCardStyle(MigrationTarget.PythonPandas)"
             @onclick="() => SelectTarget(MigrationTarget.PythonPandas)">
            <div class="d-flex align-center justify-space-between mb-2">
                <MudIcon Icon="@Icons.Material.Filled.DataArray" Color="Color.Error" Size="Size.Large" />
                @if (_selectedTarget == MigrationTarget.PythonPandas)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Error" Size="Size.Medium" />
                }
            </div>
            <MudText Typo="Typo.h6" Class="font-weight-bold">Python (Pandas)</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Generate standard Python extraction scripts using pyodbc & pandas for ELT load to Landing Zone.</MudText>
        </div>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <div Class="pa-4 mud-paper mud-elevation-2"
             style="@GetCardStyle(MigrationTarget.AzureDataFactory)"
             @onclick="() => SelectTarget(MigrationTarget.AzureDataFactory)">
            <div class="d-flex align-center justify-space-between mb-2">
                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Color="Color.Primary" Size="Size.Large" />
                @if (_selectedTarget == MigrationTarget.AzureDataFactory)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Primary" Size="Size.Medium" />
                }
            </div>
            <MudText Typo="Typo.h6" Class="font-weight-bold">Azure Data Factory</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Generate ADF Pipeline JSON definitions ready for ARM / Bicep deployment.</MudText>
        </div>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <div Class="pa-4 mud-paper mud-elevation-2"
             style="@GetCardStyle(MigrationTarget.AirflowDag)"
             @onclick="() => SelectTarget(MigrationTarget.AirflowDag)">
            <div class="d-flex align-center justify-space-between mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Air" Color="Color.Tertiary" Size="Size.Large" />
                @if (_selectedTarget == MigrationTarget.AirflowDag)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Tertiary" Size="Size.Medium" />
                }
            </div>
            <MudText Typo="Typo.h6" Class="font-weight-bold">Apache Airflow DAGs</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Orchestrate migrations with Airflow DAG Python scripts mapping SSIS control flow.</MudText>
        </div>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <div Class="pa-4 mud-paper mud-elevation-2"
             style="@GetCardStyle(MigrationTarget.ConsolidatedSql)"
             @onclick="() => SelectTarget(MigrationTarget.ConsolidatedSql)">
            <div class="d-flex align-center justify-space-between mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Success" Size="Size.Large" />
                @if (_selectedTarget == MigrationTarget.ConsolidatedSql)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Medium" />
                }
            </div>
            <MudText Typo="Typo.h6" Class="font-weight-bold">SQL Stored Procs</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Consolidate SSIS Data Flow into clean ANSI SQL Stored Procedures.</MudText>
        </div>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <div Class="pa-4 mud-paper mud-elevation-2"
             style="@GetCardStyle(MigrationTarget.BmcControlMJson)"
             @onclick="() => SelectTarget(MigrationTarget.BmcControlMJson)">
            <div class="d-flex align-center justify-space-between mb-2">
                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Secondary" Size="Size.Large" />
                @if (_selectedTarget == MigrationTarget.BmcControlMJson)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Secondary" Size="Size.Medium" />
                }
            </div>
            <MudText Typo="Typo.h6" Class="font-weight-bold">BMC Control-M JSON</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Generate Control-M Automation API JSON definitions with job events & dependencies.</MudText>
        </div>
    </MudItem>
</MudGrid>

<!-- Action Bar -->
<MudPaper Class="pa-4 mb-6 d-flex align-center justify-space-between flex-wrap gap-4" Elevation="2">
    <div class="d-flex align-center gap-4">
        <MudSelect T="string" @bind-Value="_selectedPackageId" Label="Select SSIS Package" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 280px;">
            <MudSelectItem T="string" Value="@("ALL")">📦 Convert All Packages in Project</MudSelectItem>
            @if (_packages != null)
            {
                @foreach (var p in _packages)
                {
                    <MudSelectItem T="string" Value="@p.Id">📄 @p.Name</MudSelectItem>
                }
            }
        </MudSelect>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoFixHigh"
                   OnClick="RunMigration" Size="Size.Large">
            Generate Migration Code
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Archive"
                   OnClick="DownloadProjectWorkspace" Size="Size.Large" Class="ml-2">
            Export Full Project (ZIP)
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Dark" StartIcon="@Icons.Material.Filled.RocketLaunch"
                   OnClick="OpenGitDeployDialog" Size="Size.Large" Class="ml-2">
            Deploy to Git
        </MudButton>
    </div>

    @if (_showGitDialog)
    {
        <MudPaper Class="pa-4 mt-4 w-100" Elevation="0" Style="border: 2px dashed var(--mud-palette-info); border-radius: 8px; background: rgba(14, 165, 233, 0.05);">
            <MudText Typo="Typo.h6" Class="mb-3 d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.RocketLaunch" Color="Color.Info" />
                Deploy to Git (Auto Pull-Request)
            </MudText>
            <MudGrid>
                <MudItem xs="12" md="5">
                    <MudTextField @bind-Value="_gitRepoUrl" Label="GitHub Repository URL" Variant="Variant.Outlined" Placeholder="https://github.com/user/repo.git" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_gitPat" Label="Personal Access Token (PAT)" Variant="Variant.Outlined" InputType="InputType.Password" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="_gitBranch" Label="Branch Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>
            <div class="d-flex align-center gap-3 mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="DeployToGit" Disabled="_isDeploying">
                    @if (_isDeploying)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                        <MudText Class="ms-2">Pushing to Repo...</MudText>
                    }
                    else
                    {
                        <MudText>Push & Create PR</MudText>
                    }
                </MudButton>
                <MudButton Variant="Variant.Text" OnClick="() => _showGitDialog = false">Cancel</MudButton>
            </div>
        </MudPaper>
    }

    @if (_effortDays > 0)
    {
        <MudPaper Elevation="0" Class="pa-3 mt-4 w-100" Style="background: rgba(34, 197, 94, 0.1); border: 1px solid var(--mud-palette-success); border-radius: 8px;">
            <div class="d-flex align-center justify-space-between">
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Analytics" Color="Color.Success" />
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Executive Effort Estimation</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Based on @_totalComponents components analyzed in the selected scope.</MudText>
                    </div>
                </div>
                <div class="d-flex align-center gap-4">
                    <div class="text-center">
                        <MudText Typo="Typo.h5" Class="font-weight-bold color-success">@_effortSize</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">T-Shirt Size</MudText>
                    </div>
                    <MudDivider Vertical="true" FlexItem="true" />
                    <div class="text-center">
                        <MudText Typo="Typo.h5" Class="font-weight-bold color-success">~@_effortDays Days</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Est. Dev & Test Effort</MudText>
                    </div>
                </div>
            </div>
        </MudPaper>
    }

    @if (_result != null && _result.Files.Any())
    {
        <div class="d-flex align-center gap-2 mt-3 flex-wrap">
            <MudChip T="string" Color="Color.Dark" Variant="Variant.Outlined">@_result.Files.Count Files Generated</MudChip>
            @if (_result.IsValid)
            {
                <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.CheckCircle" Style="font-weight: bold;">
                    QUALITY GATE: PASSED (100% Valid Code)
                </MudChip>
            }
            else
            {
                <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Warning" Style="font-weight: bold;">
                    MIGRATION RULE CHECK: FAILED (@_result.ValidationErrors.Count PELANGGARAN ATURAN)
                </MudChip>
            }
        </div>

        @if (!_result.IsValid)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mt-3" Style="border-radius: 8px;">
                <div class="d-flex align-center justify-space-between flex-wrap gap-3">
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.ReportProblem" />
                            MIGRATION RULE CHECK FAILED — Paket .DTSX Perlu Disesuaikan!
                        </MudText>
                        <MudText Typo="Typo.body2">
                            Hasil konversi terdeteksi melanggar standar pre-migrasi. Silakan sesuaikan paket SSIS (.dtsx), pemetaan komponen, atau koneksi database terlebih dahulu.
                        </MudText>
                    </div>
                    <MudButton Href="/modernization-guide" Target="_blank" Variant="Variant.Outlined" Color="Color.Surface" Size="Size.Small" StartIcon="@Icons.Material.Filled.MenuBook">
                        Lihat Aturan Pre-Migrasi
                    </MudButton>
                </div>
            </MudAlert>
        }

        @if (!string.IsNullOrEmpty(_result.Summary))
        {
            <MudAlert Severity="@(_result.IsValid ? Severity.Success : Severity.Warning)" Variant="Variant.Outlined" Class="mt-3">
                @_result.Summary
            </MudAlert>
        }

        @if (_result.ValidationErrors.Any())
        {
            <div class="mt-2 pa-3 mud-paper" style="background: rgba(239, 68, 68, 0.1); border: 1px solid var(--mud-palette-error); border-radius: 6px;">
                <MudText Typo="Typo.subtitle2" Color="Color.Error" Class="font-weight-bold mb-1">
                    <MudIcon Icon="@Icons.Material.Filled.BugReport" Size="Size.Small" Class="mr-1" />
                    Detail Pelanggaran Aturan Pre-Migrasi (DTSX Perlu Disesuaikan):
                </MudText>
                <ul class="pl-4 ma-0" style="font-size: 0.85rem; color: var(--mud-palette-text-primary);">
                    @foreach (var err in _result.ValidationErrors)
                    {
                        <li>@err</li>
                    }
                </ul>
            </div>
        }
    }
</MudPaper>

<!-- Result Workspace -->
@if (_result != null && _result.Files.Any())
{
    <MudGrid>
        <!-- File Explorer List -->
        <MudItem xs="12" md="4" lg="3">
            <MudPaper Class="pa-2" Elevation="3" Style="height: 540px; overflow-y: auto;">
                <div class="d-flex align-center justify-space-between pa-2">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold color-primary">
                        📁 Generated Target Files
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">ZIP Ready</MudChip>
                </div>
                <MudList T="GeneratedFile" SelectionMode="SelectionMode.SingleSelection" SelectedValue="_activeFile">
                    @foreach (var file in _result.Files)
                    {
                        <MudListItem Value="@file" OnClick="() => OnFileSelected(file)">
                            <div class="d-flex align-center justify-space-between w-100">
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@GetFileIcon(file.Language)" Size="Size.Small" Color="@GetFileIconColor(file.Language)" />
                                    <MudText Typo="Typo.body2" Class="@(file == _activeFile ? "font-weight-bold text-primary" : "")">@file.FileName</MudText>
                                </div>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        </MudItem>

        <!-- Code Preview & Diff Pane -->
        <MudItem xs="12" md="8" lg="9">
            <MudPaper Class="pa-4" Elevation="3" Style="height: 540px; display: flex; flex-direction: column;">
                @if (_activeFile != null)
                {
                    <div class="d-flex align-center justify-space-between mb-3 flex-wrap gap-2">
                        <div class="d-flex align-center gap-2">
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@_activeFile.TargetFramework</MudChip>
                            <MudText Typo="Typo.h6" Class="font-weight-bold">@_activeFile.FileName</MudText>
                        </div>
                        <div class="d-flex align-center gap-2">
                            <MudToggleGroup T="string" @bind-Value="_viewMode" Size="Size.Small" Color="Color.Info">
                                <MudToggleItem Value="@("single")">Code View</MudToggleItem>
                                <MudToggleItem Value="@("diff")">Side-by-Side Diff Inspector</MudToggleItem>
                            </MudToggleGroup>
                            <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small"
                                       StartIcon="@(_copied ? Icons.Material.Filled.Check : Icons.Material.Filled.ContentCopy)"
                                       OnClick="CopyActiveFileCode">
                                @(_copied ? "Copied!" : "Copy Code")
                            </MudButton>
                        </div>
                    </div>

                    @if (_viewMode == "diff")
                    {
                        <MudGrid Style="flex: 1; overflow: hidden;" Class="ma-0 w-100">
                            <!-- Left: SSIS Source Metadata & Logic -->
                            <MudItem xs="12" md="6" Style="height: 100%; display: flex; flex-direction: column;" Class="pa-1">
                                <div class="d-flex align-center gap-2 mb-2">
                                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Error" Size="Size.Small" />
                                    <MudText Typo="Typo.caption" Class="font-weight-bold" Style="color: #f87171;">LEGACY SSIS COMPONENT LOGIC (.DTSX)</MudText>
                                </div>
                                <div style="flex: 1; overflow: auto; background: #0f172a; border: 1px solid rgba(248, 113, 113, 0.3); border-radius: 8px; padding: 12px;">
                                    <pre class="sql-code-editor" style="margin: 0; font-size: 0.8rem; color: #cbd5e1;"><code>@GetSsisSourceSummary()</code></pre>
                                </div>
                            </MudItem>

                            <!-- Right: Modern Generated Code -->
                            <MudItem xs="12" md="6" Style="height: 100%; display: flex; flex-direction: column;" Class="pa-1">
                                <div class="d-flex align-center gap-2 mb-2">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                    <MudText Typo="Typo.caption" Class="font-weight-bold" Style="color: #4ade80;">GENERATED MODERN TARGET CODE</MudText>
                                </div>
                                <div style="flex: 1; overflow: auto; background: #0b1329; border: 1px solid rgba(74, 222, 128, 0.3); border-radius: 8px; padding: 12px;">
                                    <pre class="sql-code-editor" style="margin: 0; font-size: 0.8rem; color: #38bdf8;"><code>@_activeFile.Content</code></pre>
                                </div>
                            </MudItem>
                        </MudGrid>
                    }
                    else
                    {
                        <div style="flex: 1; overflow: auto; background: #0b1329; border-radius: 8px; padding: 12px;">
                            @if (_activeFile.Language == "sql")
                            {
                                <SqlQueryViewer Sql="@_activeFile.Content" Title="@_activeFile.FileName" />
                            }
                            else
                            {
                                <pre class="sql-code-editor"><code>@_activeFile.Content</code></pre>
                            }
                        </div>
                    }
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}
else if (_reportData == null)
{
    <MudAlert Severity="Severity.Info" Class="my-6">
        Please load an SSIS project first on the Lineage Discovery page.
    </MudAlert>
}

@code {
    private LineageReportData? _reportData;
    private List<PackageNode>? _packages;
    private MigrationTarget _selectedTarget = MigrationTarget.DbtSql;
    private string _selectedPackageId = "ALL";
    private MigrationResult? _result;
    private GeneratedFile? _activeFile;
    private string _viewMode = "single";
    private bool _copied;

    private string GetSsisSourceSummary()
    {
        if (_reportData?.Graph == null || _activeFile == null) return "-- SSIS Source Package Data Not Loaded";

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("=================================================");
        sb.AppendLine("📦 SSIS PACKAGE SOURCE METADATA (.DTSX)");
        sb.AppendLine("=================================================");
        sb.AppendLine($"Target File    : {_activeFile.FileName}");
        sb.AppendLine($"Framework      : {_activeFile.TargetFramework}");
        sb.AppendLine($"Scope Packages : {(_packages != null ? _packages.Count : 0)} DTSX Package(s)");
        sb.AppendLine($"Total Nodes    : {_reportData.Graph.Components.Count} Data Flow Components");
        sb.AppendLine();
        sb.AppendLine("--- EXCERPT OF SSIS DTSX COMPONENT PIPELINE ---");

        var compList = _reportData.Graph.Components.Take(12).ToList();
        foreach (var c in compList)
        {
            sb.AppendLine($"• Component ID : {c.Id}");
            sb.AppendLine($"  Type         : {c.ComponentType}");
            sb.AppendLine($"  Name         : {c.Name}");
            if (!string.IsNullOrWhiteSpace(c.SourceTable)) sb.AppendLine($"  Source Table : {c.SourceTable}");
            if (!string.IsNullOrWhiteSpace(c.TargetTable)) sb.AppendLine($"  Target Table : {c.TargetTable}");
            if (c.ColumnMappings != null && c.ColumnMappings.Any())
            {
                sb.AppendLine($"  Mappings     : {c.ColumnMappings.Count} Column(s) transformed");
            }
            sb.AppendLine();
        }

        return sb.ToString();
    }

    private string _effortSize = "";
    private int _effortDays = 0;
    private int _totalComponents = 0;

    private bool _showGitDialog;
    private bool _isDeploying;
    private string _gitRepoUrl = "";
    private string _gitPat = "";
    private string _gitBranch = "migration/ssis-to-airflow";

    protected override void OnInitialized()
    {
        _reportData = LineageService.GetPublishedReport();
        if (_reportData?.Graph != null)
        {
            _packages = _reportData.Graph.Packages;
            RunMigration();
        }
    }

    private void SelectTarget(MigrationTarget target)
    {
        _selectedTarget = target;
        RunMigration();
    }

    private void RunMigration()
    {
        if (_reportData?.Graph == null) return;
        _result = SsisMigrationConverter.ConvertProject(_reportData.Graph, _selectedTarget, _selectedPackageId);
        _activeFile = _result.Files.FirstOrDefault();
        CalculateEffort();
    }

    private void CalculateEffort()
    {
        if (_reportData?.Graph == null) return;
        
        var packages = _selectedPackageId == "ALL" 
            ? _reportData.Graph.Packages 
            : _reportData.Graph.Packages.Where(p => p.Id == _selectedPackageId).ToList();
            
        var packageIds = packages.Select(p => p.Id).ToHashSet();
        
        _totalComponents = _reportData.Graph.Components.Count(c => packageIds.Contains(c.PackageId));
        
        // 1.5 days per component roughly (including mapping, dev, test)
        _effortDays = (int)(_totalComponents * 1.5); 
        if (_effortDays == 0) _effortDays = 1;
        
        if (_effortDays <= 5) _effortSize = "Small";
        else if (_effortDays <= 15) _effortSize = "Medium";
        else if (_effortDays <= 40) _effortSize = "Large";
        else _effortSize = "Extra Large";
    }

    private void OnFileSelected(GeneratedFile file)
    {
        _activeFile = file;
        StateHasChanged();
    }

    private string GetExportZipFileName()
    {
        string projName = "";

        if (_reportData?.Summary != null && _reportData.Summary.TryGetValue("projectName", out var nameObj) && nameObj != null)
        {
            projName = nameObj.ToString() ?? "";
        }

        if (string.IsNullOrWhiteSpace(projName) && !string.IsNullOrWhiteSpace(_reportData?.ProjectPath))
        {
            projName = System.IO.Path.GetFileName(_reportData.ProjectPath.TrimEnd('/', '\\'));
        }

        if (string.IsNullOrWhiteSpace(projName) && _reportData?.Graph?.Packages?.Count > 0)
        {
            var firstPkg = _reportData.Graph.Packages[0];
            if (!string.IsNullOrWhiteSpace(firstPkg.ProjectPath))
            {
                var projFiles = System.IO.Directory.Exists(firstPkg.ProjectPath) 
                    ? System.IO.Directory.EnumerateFiles(firstPkg.ProjectPath, "*.dtproj").ToList() 
                    : new List<string>();
                if (projFiles.Any())
                {
                    projName = System.IO.Path.GetFileNameWithoutExtension(projFiles.First());
                }
                else
                {
                    projName = System.IO.Path.GetFileName(firstPkg.ProjectPath.TrimEnd('/', '\\'));
                }
            }
            if (string.IsNullOrWhiteSpace(projName) && !string.IsNullOrWhiteSpace(firstPkg.Name))
            {
                projName = firstPkg.Name;
            }
        }

        if (string.IsNullOrWhiteSpace(projName) || projName.Equals("lineage.json", StringComparison.OrdinalIgnoreCase))
        {
            projName = "SSIS_Migration_Project";
        }

        var cleanName = System.Text.RegularExpressions.Regex.Replace(projName, @"[^\w\-]", "_").Trim('_');
        if (string.IsNullOrEmpty(cleanName)) cleanName = "SSIS_Migration_Project";

        return $"{cleanName}_Migration.zip";
    }

    private async Task DownloadProjectWorkspace()
    {
        if (_reportData?.Graph == null) return;
        
        try
        {
            var templatePath = System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), "wwwroot", "templates", "data_engineering_project_template.zip");
            var zipBytes = ProjectExportService.ExportToTemplateZip(_reportData.Graph, templatePath);
            var base64 = Convert.ToBase64String(zipBytes);
            var zipFileName = GetExportZipFileName();
            await JS.InvokeVoidAsync("downloadFileFromBase64", zipFileName, base64);
            Snackbar.Add($"Project exported successfully as '{zipFileName}'!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task CopyActiveFileCode()
    {
        if (_activeFile == null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _activeFile.Content);
            _copied = true;
            StateHasChanged();
            await Task.Delay(2000);
            _copied = false;
            StateHasChanged();
        }
        catch
        {
            Snackbar.Add("Failed to copy code", Severity.Warning);
        }
    }

    private string GetCardStyle(MigrationTarget t)
    {
        var baseStyle = "cursor: pointer; transition: all 0.2s; border-radius: 8px; background: var(--mud-palette-surface);";
        if (_selectedTarget == t)
        {
            var borderColor = t switch
            {
                MigrationTarget.DbtSql => "#f59e0b",
                MigrationTarget.PySpark => "#3b82f6",
                MigrationTarget.PythonPandas => "#ef4444",
                MigrationTarget.AirflowDag => "#a855f7",
                MigrationTarget.AzureDataFactory => "#06b6d4",
                MigrationTarget.BmcControlMJson => "#ec4899",
                _ => "#10b981"
            };
            return $"{baseStyle} border: 2px solid {borderColor}; box-shadow: 0 4px 14px rgba(0,0,0,0.3);";
        }
        return $"{baseStyle} border: 1px solid rgba(255,255,255,0.08);";
    }

    private string GetFileIcon(string lang) => lang switch
    {
        "python" => Icons.Material.Filled.Code,
        "json" => Icons.Material.Filled.DataObject,
        "yaml" => Icons.Material.Filled.Description,
        _ => Icons.Material.Filled.Storage
    };

    private Color GetFileIconColor(string lang) => lang switch
    {
        "python" => Color.Info,
        "json" => Color.Primary,
        "yaml" => Color.Warning,
        _ => Color.Success
    };

    private void OpenGitDeployDialog()
    {
        _showGitDialog = true;
    }

    private async Task DeployToGit()
    {
        if (_reportData?.Graph == null || string.IsNullOrWhiteSpace(_gitRepoUrl) || string.IsNullOrWhiteSpace(_gitPat))
        {
            Snackbar.Add("Please enter Repository URL and Token.", Severity.Warning);
            return;
        }

        _isDeploying = true;
        StateHasChanged();

        try
        {
            var templatePath = System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), "wwwroot", "templates", "data_engineering_project_template.zip");
            var zipBytes = ProjectExportService.ExportToTemplateZip(_reportData.Graph, templatePath);
            
            var options = new GitDeploymentOptions
            {
                RepositoryUrl = _gitRepoUrl,
                PersonalAccessToken = _gitPat,
                BranchName = string.IsNullOrWhiteSpace(_gitBranch) ? "migration/ssis-to-airflow" : _gitBranch,
                CreatePullRequest = true
            };

            var prUrl = await GitIntegrationService.DeployToGitAsync(zipBytes, options);
            
            Snackbar.Add($"Deployment successful! {prUrl}", Severity.Success);
            _showGitDialog = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Deployment failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isDeploying = false;
            StateHasChanged();
        }
    }
