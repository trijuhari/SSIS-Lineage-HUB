@page "/reconciliation-tracker"
@using MudBlazor

<PageTitle>Migration Reconciliation Tracker — SSIS Lineage Hub</PageTitle>

<div class="mb-4 d-flex align-center justify-space-between flex-wrap gap-4">
    <div>
        <MudText Typo="Typo.h5" Class="d-flex align-center gap-2 font-weight-bold">
            <MudIcon Icon="@Icons.Material.Filled.CompareArrows" Color="Color.Success" Size="Size.Large" />
            Parallel Run Reconciliation Tracker
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Monitor data parity between legacy SSIS pipelines and the new Modern Data Stack (dbt/Airflow) during parallel runs.
        </MudText>
    </div>
    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Style="font-weight:700;">PARALLEL RUN</MudChip>
</div>

<MudGrid>
    <!-- Summary Cards -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex flex-column align-center justify-center h-100" Elevation="2" Style="border-top: 4px solid var(--mud-palette-success);">
            <MudText Typo="Typo.h3" Class="font-weight-bold color-success mb-2">99.8%</MudText>
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="text-center">Overall Data Parity</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex flex-column align-center justify-center h-100" Elevation="2" Style="border-top: 4px solid var(--mud-palette-info);">
            <MudText Typo="Typo.h3" Class="font-weight-bold color-info mb-2">12</MudText>
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="text-center">Active Parallel Runs</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex flex-column align-center justify-center h-100" Elevation="2" Style="border-top: 4px solid var(--mud-palette-warning);">
            <MudText Typo="Typo.h3" Class="font-weight-bold color-warning mb-2">3</MudText>
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="text-center">Pipelines with Discrepancies</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex flex-column align-center justify-center h-100" Elevation="2" Style="border-top: 4px solid var(--mud-palette-primary);">
            <MudText Typo="Typo.h3" Class="font-weight-bold color-primary mb-2">5</MudText>
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="text-center">Pipelines Ready for Cutover</MudText>
        </MudPaper>
    </MudItem>

    <!-- Reconciliation Test Upload & Input -->
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4 h-100" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-4 font-weight-bold">Register Validation Run</MudText>
            <MudSelect T="string" Label="Target Table / Pipeline" Variant="Variant.Outlined" Class="mb-4">
                <MudSelectItem Value="@("FactSales_DW")">FactSales_DW</MudSelectItem>
                <MudSelectItem Value="@("DimCustomer")">DimCustomer</MudSelectItem>
                <MudSelectItem Value="@("DimProduct")">DimProduct</MudSelectItem>
            </MudSelect>
            <MudDatePicker Label="Run Date" Variant="Variant.Outlined" Class="mb-4" />
            <MudNumericField T="int" Label="Rows in SSIS (Legacy)" Variant="Variant.Outlined" Class="mb-4" />
            <MudNumericField T="int" Label="Rows in dbt (Modern)" Variant="Variant.Outlined" Class="mb-4" />
            <MudNumericField T="int" Label="Rows with Value Mismatches" Variant="Variant.Outlined" Class="mb-4" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.Save">
                Record Test Result
            </MudButton>
        </MudPaper>
    </MudItem>

    <!-- Reconciliation Log Table -->
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4 h-100" Elevation="2">
            <div class="d-flex justify-space-between align-center mb-4">
                <MudText Typo="Typo.h6" Class="font-weight-bold">Recent Validation Logs</MudText>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download">Export CSV</MudButton>
            </div>
            <MudTable Items="@ValidationLogs" Hover="true" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Date</MudTh>
                    <MudTh>Pipeline / Table</MudTh>
                    <MudTh>Match Status</MudTh>
                    <MudTh>SSIS Rows</MudTh>
                    <MudTh>dbt Rows</MudTh>
                    <MudTh>Diffs</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Date">@context.RunDate.ToShortDateString()</MudTd>
                    <MudTd DataLabel="Pipeline"><strong>@context.TableName</strong></MudTd>
                    <MudTd DataLabel="Status">
                        @if (context.IsMatch)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">Perfect Match</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small">Discrepancy</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="SSIS Rows">@context.SsisRows.ToString("N0")</MudTd>
                    <MudTd DataLabel="dbt Rows">@context.DbtRows.ToString("N0")</MudTd>
                    <MudTd DataLabel="Diffs">
                        <MudText Color="@(context.Mismatches == 0 ? Color.Success : Color.Error)">
                            @context.Mismatches.ToString("N0")
                        </MudText>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private record ValidationLog(DateTime RunDate, string TableName, int SsisRows, int DbtRows, int Mismatches)
    {
        public bool IsMatch => SsisRows == DbtRows && Mismatches == 0;
    }

    private List<ValidationLog> ValidationLogs = new()
    {
        new ValidationLog(DateTime.Today, "FactSales_DW", 1450234, 1450234, 0),
        new ValidationLog(DateTime.Today, "DimCustomer", 89402, 89402, 0),
        new ValidationLog(DateTime.Today.AddDays(-1), "DimProduct", 1024, 1024, 5),
        new ValidationLog(DateTime.Today.AddDays(-1), "FactSales_DW", 1445100, 1445100, 0),
        new ValidationLog(DateTime.Today.AddDays(-2), "FactSales_DW", 1440000, 1439998, 12),
        new ValidationLog(DateTime.Today.AddDays(-2), "DimCustomer", 89350, 89350, 0),
        new ValidationLog(DateTime.Today.AddDays(-2), "DimProduct", 1024, 1024, 14)
    };
}
