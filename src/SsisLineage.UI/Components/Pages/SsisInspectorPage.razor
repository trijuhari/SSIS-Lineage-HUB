@page "/ssis-inspector"
@using SsisLineage.Core
@using SsisLineage.Core.Models
@using SsisLineage.UI.Services
@inject LineageService LineageService

<PageTitle>SSIS Performance Inspector — SSIS Lineage Hub</PageTitle>

<div class="mb-4 d-flex align-center justify-space-between flex-wrap gap-4">
    <div>
        <MudText Typo="Typo.h5" Class="d-flex align-center gap-2 font-weight-bold">
            <MudIcon Icon="@Icons.Material.Filled.HealthAndSafety" Color="Color.Success" Size="Size.Large" />
            SSIS Performance & Anti-Pattern Inspector
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Audit otomatis kinerja, kejanggalan desain (anti-patterns), dan risiko keamanan pada paket SSIS.
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadInspection">
        Re-Audit Project
    </MudButton>
</div>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-6" />
}
else if (_report != null)
{
    <!-- Stat Cards Header -->
    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 d-flex align-center gap-4" Elevation="3" Style="background: linear-gradient(135deg, rgba(16,185,129,0.15), rgba(6,182,212,0.1)); border-left: 4px solid var(--mud-palette-success);">
                <MudAvatar Size="Size.Large" Color="@GetGradeColor(_report.HealthGrade)">
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@_report.HealthGrade</MudText>
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">PROJECT HEALTH SCORE</MudText>
                    <MudText Typo="Typo.h4" Class="font-weight-bold">@_report.HealthScore%</MudText>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 d-flex align-center gap-4" Elevation="3" Style="border-left: 4px solid var(--mud-palette-error);">
                <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Color="Color.Error" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">CRITICAL ISSUES</MudText>
                    <MudText Typo="Typo.h4" Class="font-weight-bold" Color="Color.Error">@_report.CriticalCount</MudText>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 d-flex align-center gap-4" Elevation="3" Style="border-left: 4px solid var(--mud-palette-warning);">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">WARNINGS</MudText>
                    <MudText Typo="Typo.h4" Class="font-weight-bold" Color="Color.Warning">@_report.WarningCount</MudText>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 d-flex align-center gap-4" Elevation="3" Style="border-left: 4px solid var(--mud-palette-info);">
                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">ASSETS INSPECTED</MudText>
                    <MudText Typo="Typo.h6" Class="font-weight-bold">
                        @_report.TotalPackages Pkgs / @_report.TotalComponents Comps
                    </MudText>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Filters & Search Toolbar -->
    <MudPaper Class="pa-4 mb-6" Elevation="2">
        <div class="d-flex align-center gap-4 flex-wrap">
            <MudTextField @bind-Value="_searchQuery" Placeholder="Cari aturan, komponen, atau paket…" Immediate="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 260px;" />

            <MudSelect T="string" @bind-Value="_selectedSeverity" Label="Severity" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 140px;">
                <MudSelectItem T="string" Value="@("All")">All Severities</MudSelectItem>
                <MudSelectItem T="string" Value="@("Critical")">🔴 Critical</MudSelectItem>
                <MudSelectItem T="string" Value="@("Warning")">🟡 Warning</MudSelectItem>
                <MudSelectItem T="string" Value="@("Info")">🔵 Info</MudSelectItem>
            </MudSelect>

            <MudSelect T="string" @bind-Value="_selectedCategory" Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 160px;">
                <MudSelectItem T="string" Value="@("All")">All Categories</MudSelectItem>
                <MudSelectItem T="string" Value="@("Performance")">Performance</MudSelectItem>
                <MudSelectItem T="string" Value="@("Security")">Security</MudSelectItem>
                <MudSelectItem T="string" Value="@("Architecture")">Architecture</MudSelectItem>
                <MudSelectItem T="string" Value="@("Maintainability")">Maintainability</MudSelectItem>
            </MudSelect>

            <MudSpacer />

            <MudChip T="string" Size="Size.Medium" Color="Color.Default" Variant="Variant.Outlined">
                Showing @FilteredFindings.Count() of @_report.Findings.Count findings
            </MudChip>
        </div>
    </MudPaper>

    <!-- Findings List -->
    @if (!FilteredFindings.Any())
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="my-4">
            🎉 Tidak ditemukan masalah anti-pattern untuk filter yang dipilih! Paket SSIS Anda dalam kondisi optimal.
        </MudAlert>
    }
    else
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var f in FilteredFindings)
            {
                <MudPaper Class="pa-4" Elevation="3" Style="@GetFindingBorder(f.Severity)">
                    <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
                        <div class="d-flex align-center gap-2">
                            <MudChip T="string" Size="Size.Small" Color="Color.Dark" Variant="Variant.Filled" Style="font-weight:700;">@f.RuleId</MudChip>
                            <MudText Typo="Typo.h6" Class="font-weight-bold">@f.RuleTitle</MudText>
                        </div>
                        <div class="d-flex align-center gap-2">
                            <MudChip T="string" Size="Size.Small" Color="@GetCategoryColor(f.Category)" Variant="Variant.Outlined">@f.Category</MudChip>
                            <MudChip T="string" Size="Size.Small" Color="@GetSeverityColor(f.Severity)" Variant="Variant.Filled">@f.Severity</MudChip>
                        </div>
                    </div>

                    <div class="d-flex align-center gap-4 my-2 text-secondary" style="font-size: 0.85rem;">
                        <span>📦 <strong>Package:</strong> @f.PackageName</span>
                        <span>⚙️ <strong>Component:</strong> @f.TaskOrComponentName</span>
                    </div>

                    <!-- Masalah / Explanation -->
                    <div class="mt-3 mb-2 pa-3" style="background: rgba(255,255,255,0.03); border-radius: 6px; border-left: 3px solid var(--mud-palette-text-secondary);">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold color-error">📌 Analisis Masalah:</MudText>
                        <MudText Typo="Typo.body2" Class="mt-1">@f.Description</MudText>
                    </div>

                    <!-- Cara Perbaikan / Remediation -->
                    <div class="mb-3 pa-3" style="background: rgba(16,185,129,0.08); border-radius: 6px; border-left: 3px solid var(--mud-palette-success);">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold text-success">💡 Panduan Perbaikan (Remediation):</MudText>
                        <MudText Typo="Typo.body2" Class="mt-1">@f.Remediation</MudText>
                    </div>

                    <!-- Code / Snippet -->
                    @if (!string.IsNullOrEmpty(f.Snippet))
                    {
                        <div class="mt-2">
                            @if (f.Snippet.Contains("SELECT", StringComparison.OrdinalIgnoreCase) || f.Snippet.Contains("INSERT", StringComparison.OrdinalIgnoreCase))
                            {
                                <SqlQueryViewer Sql="@f.Snippet" Title="Problematic Query Snippet" />
                            }
                            else
                            {
                                <div class="pa-2 px-3" style="background: #0f172a; border-radius: 6px; font-family: monospace; font-size: 0.82rem; color: #cbd5e1;">
                                    @f.Snippet
                                </div>
                            }
                        </div>
                    }
                </MudPaper>
            }
        </div>
    }
}
else
{
    <MudAlert Severity="Severity.Info" Class="my-6">
        Silakan muat ulang atau buka halaman Lineage Discovery terlebih dahulu untuk memindai paket SSIS.
    </MudAlert>
}

@code {
    private bool _loading = true;
    private ProjectInspectionReport? _report;
    private string _searchQuery = "";
    private string _selectedSeverity = "All";
    private string _selectedCategory = "All";

    protected override async Task OnInitializedAsync()
    {
        await LoadInspection();
    }

    private async Task LoadInspection()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var data = LineageService.GetPublishedReport();
            if (data?.Graph != null)
            {
                _report = SsisPerformanceInspector.InspectProject(data.Graph);
            }
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private IEnumerable<InspectionFinding> FilteredFindings
    {
        get {
            if (_report == null) return Enumerable.Empty<InspectionFinding>();

            var items = _report.Findings.AsEnumerable();

            if (_selectedSeverity != "All" && Enum.TryParse<InspectionSeverity>(_selectedSeverity, out var sev))
            {
                items = items.Where(x => x.Severity == sev);
            }

            if (_selectedCategory != "All" && Enum.TryParse<InspectionCategory>(_selectedCategory, out var cat))
            {
                items = items.Where(x => x.Category == cat);
            }

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.Trim();
                items = items.Where(x =>
                    x.RuleId.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    x.RuleTitle.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    x.PackageName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    x.TaskOrComponentName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    x.Description.Contains(q, StringComparison.OrdinalIgnoreCase)
                );
            }

            return items;
        }
    }

    private Color GetSeverityColor(InspectionSeverity sev) => sev switch
    {
        InspectionSeverity.Critical => Color.Error,
        InspectionSeverity.Warning => Color.Warning,
        _ => Color.Info
    };

    private Color GetCategoryColor(InspectionCategory cat) => cat switch
    {
        InspectionCategory.Performance => Color.Primary,
        InspectionCategory.Security => Color.Error,
        InspectionCategory.Architecture => Color.Secondary,
        _ => Color.Tertiary
    };

    private Color GetGradeColor(string grade) => grade switch
    {
        "A+" or "A" => Color.Success,
        "B" => Color.Info,
        "C" => Color.Warning,
        _ => Color.Error
    };

    private string GetFindingBorder(InspectionSeverity sev) => sev switch
    {
        InspectionSeverity.Critical => "border-left: 5px solid var(--mud-palette-error);",
        InspectionSeverity.Warning => "border-left: 5px solid var(--mud-palette-warning);",
        _ => "border-left: 5px solid var(--mud-palette-info);"
    };
}
