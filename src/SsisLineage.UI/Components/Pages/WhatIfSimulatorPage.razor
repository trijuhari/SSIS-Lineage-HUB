@page "/what-if"
@using System.Linq
@using SsisLineage.Core
@using SsisLineage.Core.Models
@using SsisLineage.UI.Services
@inject LineageService LineageService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>What-If Impact Simulator — SSIS Lineage Hub</PageTitle>

<style>
    .simulator-panel {
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
    }

    .preset-chip {
        cursor: pointer;
        transition: all 0.2s ease;
        border: 1px solid rgba(251, 191, 36, 0.3) !important;
        background: rgba(251, 191, 36, 0.05) !important;
    }

    .preset-chip:hover {
        background: rgba(251, 191, 36, 0.15) !important;
        transform: translateY(-2px);
    }

    .checklist-step {
        background: rgba(15, 23, 42, 0.4);
        border-radius: 12px;
        padding: 14px 16px;
        border: 1px solid rgba(255, 255, 255, 0.06);
        transition: all 0.2s ease;
    }

    .checklist-step:hover {
        border-color: rgba(255, 255, 255, 0.15);
        background: rgba(15, 23, 42, 0.7);
    }

    .impact-stat-card {
        background: rgba(15, 23, 42, 0.5);
        border-radius: 14px;
        padding: 16px;
        border: 1px solid rgba(255, 255, 255, 0.06);
        text-align: center;
    }
</style>

<MudStack Spacing="5" Class="pa-4">

    <!-- ── Header & Action Toolbar ── -->
    <div class="d-flex justify-space-between align-center flex-wrap gap-3">
        <div>
            <div class="d-flex align-center gap-2 mb-1">
                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled" Style="font-weight: 700;">
                    IMPACT SIMULATOR
                </MudChip>
                <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">
                    100% Offline • Graph Traversal
                </MudChip>
            </div>
            <MudText Typo="Typo.h4" Style="font-weight:800; letter-spacing: -0.02em;">What-If Blast-Radius Simulator</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                Simulate schema refactoring (renaming/dropping tables or columns) and predict broken SSIS packages, mapping failures, and downstream impact before touching database DDL.
            </MudText>
        </div>

        @if (_result != null)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.Download"
                       OnClick="ExportMarkdown">Export Migration Checklist (.md)</MudButton>
        }
    </div>

    <!-- ── Guard: No Report Loaded ── -->
    @if (_graph == null)
    {
        <MudPaper Outlined="true" Elevation="0" Class="pa-10 d-flex flex-column align-center justify-center simulator-panel">
            <div class="pa-4 rounded-circle mb-3" style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.2);">
                <MudIcon Icon="@Icons.Material.Filled.Science" Size="Size.Large" Color="Color.Warning" />
            </div>
            <MudText Typo="Typo.h6" Style="font-weight:700;">No SSIS Lineage Report Loaded</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4" Style="max-width: 480px;">
                Scan or parse an SSIS package on the Lineage Discovery workspace first to perform interactive schema change simulations.
            </MudText>
            <MudButton Href="/lineage" Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Hub">
                Open Lineage Workspace
            </MudButton>
        </MudPaper>
    }
    else
    {
        <!-- ── Quick Preset Scenarios ── -->
        <MudPaper Class="pa-4 simulator-panel" Elevation="2">
            <div class="d-flex align-center gap-2 mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Bolt" Color="Color.Warning" Size="Size.Small" />
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: #f1f5f9;">
                    Quick Simulation Presets
                </MudText>
            </div>
            <div class="d-flex align-center gap-2 flex-wrap">
                <MudChip T="string" Class="preset-chip" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                         Icon="@Icons.Material.Filled.DriveFileRenameOutline" OnClick="ApplyRenamePkPreset">
                    ⚡ Rename Column (NoPinjaman → LoanID)
                </MudChip>
                <MudChip T="string" Class="preset-chip" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                         Icon="@Icons.Material.Filled.DeleteForever" OnClick="ApplyDropFactPreset">
                    💥 Drop Core Table (dbo.FactSimpanan)
                </MudChip>
                <MudChip T="string" Class="preset-chip" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                         Icon="@Icons.Material.Filled.Transform" OnClick="ApplyTypeShiftPreset">
                    🔄 Type Shift (BranchCode :: INT → NVARCHAR)
                </MudChip>
            </div>
        </MudPaper>

        <MudGrid Spacing="4">

            <!-- ── LEFT PANEL: Change Builder ── -->
            <MudItem xs="12" md="5">
                <MudPaper Class="pa-5 simulator-panel" Elevation="3" Style="height:100%; border:1px solid rgba(251,191,36,0.2);">

                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.h6" Style="font-weight:700;">Proposed Schema Changes</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                            @_pendingChanges.Count Queued
                        </MudChip>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-4">
                        Configure atomic DDL refactoring operations to simulate multi-step blast radius.
                    </MudText>

                    <!-- Change type selector -->
                    <MudSelect @bind-Value="_newChangeType" Label="Refactoring Operation" Variant="Variant.Outlined"
                               Margin="Margin.Dense" Class="mb-3"
                               AdornmentIcon="@Icons.Material.Filled.SwapHoriz" Adornment="Adornment.Start">
                        <MudSelectItem Value="SimulationChangeType.RenameColumn">Rename Column</MudSelectItem>
                        <MudSelectItem Value="SimulationChangeType.DropColumn">Drop Column</MudSelectItem>
                        <MudSelectItem Value="SimulationChangeType.RenameTable">Rename Table</MudSelectItem>
                        <MudSelectItem Value="SimulationChangeType.DropTable">Drop Table</MudSelectItem>
                        <MudSelectItem Value="SimulationChangeType.ChangeColumnType">Change Column Type</MudSelectItem>
                    </MudSelect>

                    <!-- Table autocomplete -->
                    <MudAutocomplete T="string" @bind-Value="_newTable" Label="Target Table (e.g. dbo.MasterPinjaman)"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                     SearchFunc="SearchTables" CoerceValue="true" Clearable="true"
                                     MaxItems="30" ResetValueOnEmptyText="false"
                                     Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.TableChart"
                                     Placeholder="Type to search tables..." />

                    <!-- Column (hidden for table-level ops) -->
                    @if (_newChangeType is SimulationChangeType.RenameColumn
                                       or SimulationChangeType.DropColumn
                                       or SimulationChangeType.ChangeColumnType)
                    {
                        <MudAutocomplete T="string" @bind-Value="_newColumn" Label="Target Column"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                         SearchFunc="SearchColumns" CoerceValue="true" Clearable="true"
                                         MaxItems="30" ResetValueOnEmptyText="false"
                                         Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.ViewColumn"
                                         Placeholder="Type to search columns..." />
                    }

                    <!-- New name (rename operations) -->
                    @if (_newChangeType is SimulationChangeType.RenameColumn or SimulationChangeType.RenameTable)
                    {
                        <MudTextField @bind-Value="_newName" Label="New Name" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Class="mb-3"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.DriveFileRenameOutline"
                                      Placeholder="Enter new identifier..." />
                    }

                    <!-- New type (type change operation) -->
                    @if (_newChangeType == SimulationChangeType.ChangeColumnType)
                    {
                        <MudTextField @bind-Value="_newType" Label="New Datatype (e.g. NVARCHAR(255))"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Transform"
                                      Placeholder="VARCHAR(100), INT, DATETIME2, ..." />
                    }

                    @if (!string.IsNullOrEmpty(_addError))
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">@_addError</MudAlert>
                    }

                    <MudButton OnClick="AddChange" Variant="Variant.Filled" Color="Color.Warning"
                               FullWidth="true" StartIcon="@Icons.Material.Filled.Add" Style="border-radius:10px; font-weight: 700;">
                        Add Refactoring Step
                    </MudButton>

                    <!-- Queued changes list -->
                    @if (_pendingChanges.Any())
                    {
                        <MudDivider Class="my-4" />
                        <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight:700;">
                            Staged Refactoring Queue (@_pendingChanges.Count)
                        </MudText>
                        @foreach (var (change, idx) in _pendingChanges.Select((c, i) => (c, i)))
                        {
                            <div class="d-flex justify-space-between align-center mb-2 px-3 py-2"
                                 style="background:rgba(251,191,36,0.08); border-radius:10px; border:1px solid rgba(251,191,36,0.2);">
                                <div>
                                    <MudText Typo="Typo.body2" Style="font-weight:700; color: #f8fafc;">@DescribeChange(change)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Warning">@ChangeTypeLabel(change.ChangeType)</MudText>
                                </div>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                               Color="Color.Error" OnClick="@(() => RemoveChange(idx))" />
                            </div>
                        }

                        <MudButton OnClick="RunSimulation" Variant="Variant.Filled" Color="Color.Error"
                                   FullWidth="true" Class="mt-3" Style="border-radius:10px; font-weight: 800; height: 44px;"
                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                   Disabled="_isRunning">
                            @(_isRunning ? "Calculating Blast Radius..." : $"Simulate Impact ({_pendingChanges.Count} Step(s))")
                        </MudButton>
                        <MudButton OnClick="ClearAll" Variant="Variant.Text" Color="Color.Default"
                                   FullWidth="true" Class="mt-1" Style="border-radius:8px;">
                            Clear Simulation Queue
                        </MudButton>
                    }

                </MudPaper>
            </MudItem>

            <!-- ── RIGHT PANEL: Results Workspace ── -->
            <MudItem xs="12" md="7">
                @if (_result == null && !_isRunning)
                {
                    <MudPaper Class="pa-8 d-flex flex-column align-center justify-center simulator-panel"
                              Elevation="1" Style="min-height:380px; border:1px dashed rgba(255,255,255,0.15);">
                        <div class="pa-4 rounded-circle mb-3" style="background: rgba(251, 191, 36, 0.08);">
                            <MudIcon Icon="@Icons.Material.Filled.BubbleChart" Size="Size.Large" Style="color:rgba(251,191,36,0.6);" />
                        </div>
                        <MudText Typo="Typo.h6" Style="font-weight:700;" Class="mt-2">Simulation Engine Ready</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mt-1" Style="max-width: 400px;">
                            Queue proposed DDL changes on the left panel or click a <strong>Quick Simulation Preset</strong> to compute downstream breakages.
                        </MudText>
                    </MudPaper>
                }
                else if (_isRunning)
                {
                    <MudPaper Class="pa-8 d-flex flex-column align-center justify-center simulator-panel"
                              Elevation="1" Style="min-height:380px;">
                        <MudProgressCircular Indeterminate="true" Color="Color.Warning" Size="Size.Large" Value="75" />
                        <MudText Typo="Typo.subtitle1" Class="mt-4 font-weight-bold">Traversing Lineage Graph & Calculating Blast Radius...</MudText>
                    </MudPaper>
                }
                else if (_result != null)
                {
                    <MudStack Spacing="4">

                        <!-- Summary banner -->
                        <MudPaper Class="pa-4 simulator-panel" Elevation="2" Style="@BannerStyle">
                            <div class="d-flex align-center justify-space-between mb-3">
                                <div class="d-flex align-center gap-3">
                                    <MudIcon Icon="@(_result.HasCritical ? Icons.Material.Filled.Warning : Icons.Material.Filled.CheckCircle)"
                                             Color="@(_result.HasCritical ? Color.Error : Color.Success)" Size="Size.Medium" />
                                    <div>
                                        <MudText Typo="Typo.h6" Style="font-weight:800;">
                                            @(_result.HasCritical ? "Critical Pipeline Breakages Detected" : "Safe Operation — No Critical Breaks Found")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            Blast radius calculated across @_graph.Packages.Count package(s) and @_graph.ColumnMappings.Count mapping(s).
                                        </MudText>
                                    </div>
                                </div>
                                <MudChip T="string" Color="@(_result.HasCritical ? Color.Error : Color.Success)" Variant="Variant.Filled" Style="font-weight: 700;">
                                    @(_result.HasCritical ? "HIGH BLAST RADIUS" : "LOW RISK")
                                </MudChip>
                            </div>

                            <MudGrid Spacing="2">
                                <MudItem xs="6" sm="3">
                                    <div class="impact-stat-card" style="border-top: 3px solid #ef4444;">
                                        <MudText Typo="Typo.h4" Style="font-weight:800; color:#ef4444;">@_result.AffectedPackages</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Affected Packages</MudText>
                                    </div>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <div class="impact-stat-card" style="border-top: 3px solid #ef4444;">
                                        <MudText Typo="Typo.h4" Style="font-weight:800; color:#ef4444;">@_result.AffectedMappings</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Broken Mappings</MudText>
                                    </div>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <div class="impact-stat-card" style="border-top: 3px solid #f59e0b;">
                                        <MudText Typo="Typo.h4" Style="font-weight:800; color:#f59e0b;">@_result.AffectedProcedures</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Impacted Procs</MudText>
                                    </div>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <div class="impact-stat-card" style="border-top: 3px solid #f59e0b;">
                                        <MudText Typo="Typo.h4" Style="font-weight:800; color:#f59e0b;">@_result.AffectedTasks</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Impacted Tasks</MudText>
                                    </div>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        <!-- Findings grid -->
                        @if (_result.Findings.Any())
                        {
                            <MudPaper Class="pa-4 simulator-panel" Elevation="2">
                                <div class="d-flex align-center justify-space-between mb-3">
                                    <MudText Typo="Typo.subtitle1" Style="font-weight:800;">
                                        🔍 Detailed Impact Findings (@_result.Findings.Count)
                                    </MudText>
                                </div>
                                <MudDataGrid T="ImpactFinding" Items="_result.Findings" Dense="true" Hover="true" Striped="true"
                                             FixedHeader="true" Height="280px" SortMode="SortMode.None">
                                    <Columns>
                                        <TemplateColumn Title="Severity">
                                            <CellTemplate>
                                                @if (context.Item.Severity == ImpactSeverity.Critical)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Style="font-size:0.65rem; font-weight:700;">Critical</MudChip>
                                                }
                                                else if (context.Item.Severity == ImpactSeverity.Warning)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Style="font-size:0.65rem; font-weight:700;">Warning</MudChip>
                                                }
                                                else
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Style="font-size:0.65rem;">Info</MudChip>
                                                }
                                            </CellTemplate>
                                        </TemplateColumn>
                                        <PropertyColumn Property="x => x.Category" Title="Category" />
                                        <PropertyColumn Property="x => x.Location" Title="Location / Component" />
                                        <PropertyColumn Property="x => x.Description" Title="Impact Details" />
                                    </Columns>
                                </MudDataGrid>
                            </MudPaper>
                        }

                        <!-- Migration checklist -->
                        @if (_result.Checklist.Any())
                        {
                            <MudPaper Class="pa-4 simulator-panel" Elevation="2">
                                <div class="d-flex align-center justify-space-between mb-3">
                                    <MudText Typo="Typo.subtitle1" Style="font-weight:800;">
                                        📋 Recommended Action Checklist (@_result.Checklist.Count Steps)
                                    </MudText>
                                </div>
                                <MudStack Spacing="2">
                                    @foreach (var (item, i) in _result.Checklist.Select((x, i) => (x, i + 1)))
                                    {
                                        <div class="checklist-step d-flex align-start gap-3">
                                            <MudAvatar Size="Size.Small" Color="@(item.IsRequired ? Color.Error : Color.Warning)"
                                                       Variant="Variant.Filled" Style="min-width:28px; width:28px; height:28px; font-weight:800; font-size:0.75rem;">
                                                @i
                                            </MudAvatar>
                                            <div style="min-width:0; flex:1;">
                                                <div class="d-flex align-center justify-space-between gap-2 flex-wrap mb-1">
                                                    <MudText Typo="Typo.body2" Style="font-weight:700; color:#f8fafc;">@item.Action</MudText>
                                                    @if (item.IsRequired)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined" Style="height:20px; font-size:0.65rem;">Required</MudChip>
                                                    }
                                                    else
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Style="height:20px; font-size:0.65rem;">Recommended</MudChip>
                                                    }
                                                </div>
                                                <MudText Typo="Typo.caption" Style="color:#60a5fa; font-family:monospace; word-break:break-all;">@item.Target</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">@item.Reason</MudText>
                                            </div>
                                        </div>
                                    }
                                </MudStack>
                            </MudPaper>
                        }

                        @if (!_result.Findings.Any())
                        {
                            <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Style="border-radius:14px;">
                                <strong>Zero Blast Radius Detected!</strong> The proposed changes do not disrupt any existing column mappings, tasks, or SQL procedures in this lineage graph.
                            </MudAlert>
                        }

                    </MudStack>
                }
            </MudItem>
        </MudGrid>
    }

</MudStack>

@code {
    private LineageGraph? _graph;

    // Form fields
    private SimulationChangeType _newChangeType = SimulationChangeType.RenameColumn;
    private string _newTable  = "";
    private string _newColumn = "";
    private string _newName   = "";
    private string _newType   = "";
    private string _addError  = "";

    // Queued changes & result
    private readonly List<SchemaChange> _pendingChanges = new();
    private SimulationResult? _result;
    private bool _isRunning;

    // Table/column autocomplete caches
    private List<string> _allTables  = new();
    private List<string> _allColumns = new();

    protected override void OnInitialized()
    {
        var report = LineageService.GetPublishedReport();
        if (report == null) return;
        _graph = report.Graph;
        BuildAutocompleteData();
    }

    private void BuildAutocompleteData()
    {
        if (_graph == null) return;

        var tables = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var columns = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var m in _graph.ColumnMappings)
        {
            void AddTable(string schema, string table, string comp)
            {
                if (!string.IsNullOrEmpty(table))
                    tables.Add(string.IsNullOrEmpty(schema) ? table : $"{schema}.{table}");
                else if (!string.IsNullOrEmpty(comp))
                    tables.Add(comp);
            }

            AddTable(m.SourceSchema, m.SourceTable, m.SourceComponentName);
            AddTable(m.TargetSchema, m.TargetTable, m.TargetComponentName);

            if (!string.IsNullOrEmpty(m.SourceColumnName)) columns.Add(m.SourceColumnName);
            if (!string.IsNullOrEmpty(m.TargetColumnName)) columns.Add(m.TargetColumnName);
        }

        _allTables  = tables.OrderBy(t => t, StringComparer.OrdinalIgnoreCase).ToList();
        _allColumns = columns.OrderBy(c => c, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private Task<IEnumerable<string>> SearchTables(string? v, CancellationToken _)
    {
        if (string.IsNullOrWhiteSpace(v))
            return Task.FromResult(_allTables.Take(20).AsEnumerable());
        return Task.FromResult(
            _allTables.Where(t => t.Contains(v, StringComparison.OrdinalIgnoreCase)).Take(20).AsEnumerable());
    }

    private Task<IEnumerable<string>> SearchColumns(string? v, CancellationToken _)
    {
        IEnumerable<string> candidates = _allColumns;
        if (!string.IsNullOrEmpty(_newTable) && _graph != null)
        {
            var tbl = _newTable.ToLowerInvariant();
            var colsForTable = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var m in _graph.ColumnMappings)
            {
                bool srcMatch = MatchesTableLocal(m.SourceSchema, m.SourceTable, m.SourceComponentName, tbl);
                bool tgtMatch = MatchesTableLocal(m.TargetSchema, m.TargetTable, m.TargetComponentName, tbl);
                if (srcMatch && !string.IsNullOrEmpty(m.SourceColumnName)) colsForTable.Add(m.SourceColumnName);
                if (tgtMatch && !string.IsNullOrEmpty(m.TargetColumnName)) colsForTable.Add(m.TargetColumnName);
            }
            if (colsForTable.Any()) candidates = colsForTable.OrderBy(c => c, StringComparer.OrdinalIgnoreCase);
        }

        if (string.IsNullOrWhiteSpace(v))
            return Task.FromResult(candidates.Take(20));
        return Task.FromResult(
            candidates.Where(c => c.Contains(v, StringComparison.OrdinalIgnoreCase)).Take(20));
    }

    private static bool MatchesTableLocal(string schema, string table, string comp, string target)
    {
        if (!string.IsNullOrEmpty(table))
        {
            var q = string.IsNullOrEmpty(schema) ? table : $"{schema}.{table}";
            if (q.Equals(target, StringComparison.OrdinalIgnoreCase)) return true;
            if (table.Equals(target.Split('.').Last(), StringComparison.OrdinalIgnoreCase)) return true;
        }
        if (!string.IsNullOrEmpty(comp))
            return comp.Equals(target, StringComparison.OrdinalIgnoreCase) ||
                   comp.Split('.').Last().Equals(target.Split('.').Last(), StringComparison.OrdinalIgnoreCase);
        return false;
    }

    private void ApplyRenamePkPreset()
    {
        _pendingChanges.Clear();
        var targetTable = _allTables.FirstOrDefault(t => t.Contains("Pinjaman", StringComparison.OrdinalIgnoreCase)) ?? _allTables.FirstOrDefault() ?? "dbo.MasterPinjaman";
        _pendingChanges.Add(new SchemaChange
        {
            ChangeType = SimulationChangeType.RenameColumn,
            Table = targetTable,
            Column = "NoPinjaman",
            NewName = "LoanID"
        });
        _ = RunSimulation();
    }

    private void ApplyDropFactPreset()
    {
        _pendingChanges.Clear();
        var targetTable = _allTables.FirstOrDefault(t => t.Contains("Simpanan", StringComparison.OrdinalIgnoreCase)) ?? _allTables.FirstOrDefault() ?? "dbo.FactSimpanan";
        _pendingChanges.Add(new SchemaChange
        {
            ChangeType = SimulationChangeType.DropTable,
            Table = targetTable
        });
        _ = RunSimulation();
    }

    private void ApplyTypeShiftPreset()
    {
        _pendingChanges.Clear();
        var targetTable = _allTables.FirstOrDefault(t => t.Contains("Branch", StringComparison.OrdinalIgnoreCase)) ?? _allTables.FirstOrDefault() ?? "dbo.RefBranch";
        _pendingChanges.Add(new SchemaChange
        {
            ChangeType = SimulationChangeType.ChangeColumnType,
            Table = targetTable,
            Column = "BranchCode",
            NewType = "NVARCHAR(50)"
        });
        _ = RunSimulation();
    }

    private void AddChange()
    {
        _addError = "";

        if (string.IsNullOrWhiteSpace(_newTable))
        {
            _addError = "Please specify a target table.";
            return;
        }

        bool needsColumn = _newChangeType is SimulationChangeType.RenameColumn
                                           or SimulationChangeType.DropColumn
                                           or SimulationChangeType.ChangeColumnType;
        if (needsColumn && string.IsNullOrWhiteSpace(_newColumn))
        {
            _addError = "Please specify a column for this operation.";
            return;
        }

        bool needsNewName = _newChangeType is SimulationChangeType.RenameColumn
                                            or SimulationChangeType.RenameTable;
        if (needsNewName && string.IsNullOrWhiteSpace(_newName))
        {
            _addError = "Please enter the new identifier name.";
            return;
        }

        if (_newChangeType == SimulationChangeType.ChangeColumnType && string.IsNullOrWhiteSpace(_newType))
        {
            _addError = "Please specify the target data type.";
            return;
        }

        _pendingChanges.Add(new SchemaChange
        {
            ChangeType = _newChangeType,
            Table      = _newTable.Trim(),
            Column     = _newColumn.Trim(),
            NewName    = _newName.Trim(),
            NewType    = _newType.Trim()
        });

        _newTable  = "";
        _newColumn = "";
        _newName   = "";
        _newType   = "";
        _result    = null;
    }

    private void RemoveChange(int idx)
    {
        if (idx >= 0 && idx < _pendingChanges.Count)
        {
            _pendingChanges.RemoveAt(idx);
            _result = null;
        }
    }

    private void ClearAll()
    {
        _pendingChanges.Clear();
        _result = null;
    }

    private async Task RunSimulation()
    {
        if (_graph == null || !_pendingChanges.Any()) return;
        _isRunning = true;
        StateHasChanged();

        await Task.Delay(100);
        _result = ImpactSimulator.Simulate(_graph, _pendingChanges);
        _isRunning = false;
    }

    private async Task ExportMarkdown()
    {
        if (_result == null) return;
        var md = ImpactSimulator.GenerateMarkdown(_result);
        var bytes  = System.Text.Encoding.UTF8.GetBytes(md);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadFileFromBase64", "migration-checklist.md", base64);
        Snackbar.Add("Exported Migration Checklist (.md) successfully!", Severity.Success);
    }

    private string BannerStyle => _result?.HasCritical == true
        ? "border-radius:16px; border:1px solid rgba(239,68,68,0.4); background: linear-gradient(145deg, rgba(239,68,68,0.1) 0%, rgba(15,23,42,0.7) 100%);"
        : "border-radius:16px; border:1px solid rgba(16,185,129,0.4); background: linear-gradient(145deg, rgba(16,185,129,0.1) 0%, rgba(15,23,42,0.7) 100%);";

    // ── Helpers ────────────────────────────────────────────────────────────────
    private static string DescribeChange(SchemaChange c) => c.ChangeType switch
    {
        SimulationChangeType.RenameColumn  => $"{c.Table}.{c.Column} → {c.NewName}",
        SimulationChangeType.DropColumn    => $"DROP {c.Table}.{c.Column}",
        SimulationChangeType.RenameTable   => $"{c.Table} → {c.NewName}",
        SimulationChangeType.DropTable     => $"DROP TABLE {c.Table}",
        SimulationChangeType.ChangeColumnType => $"{c.Table}.{c.Column} :: {c.NewType}",
        _ => c.ChangeType.ToString()
    };

    private static string ChangeTypeLabel(SimulationChangeType t) => t switch
    {
        SimulationChangeType.RenameColumn  => "Rename Column",
        SimulationChangeType.DropColumn    => "Drop Column",
        SimulationChangeType.RenameTable   => "Rename Table",
        SimulationChangeType.DropTable     => "Drop Table",
        SimulationChangeType.ChangeColumnType => "Change Column Type",
        _ => t.ToString()
    };
}
