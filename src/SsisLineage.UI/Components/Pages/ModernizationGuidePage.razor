@page "/modernization-guide"
@using MudBlazor

<PageTitle>Pre-Migration Rules — SSIS Lineage Hub</PageTitle>

<!-- Modern Hero Header -->
<div class="pa-6 mb-6 rounded-lg" style="background: linear-gradient(135deg, rgba(30, 27, 75, 0.9) 0%, rgba(49, 46, 129, 0.8) 50%, rgba(88, 28, 135, 0.9) 100%); border: 1px solid rgba(168, 85, 247, 0.2); backdrop-filter: blur(12px); box-shadow: 0 10px 30px -10px rgba(79, 70, 229, 0.3);">
    <div class="d-flex align-center justify-space-between flex-wrap gap-4">
        <div>
            <div class="d-flex align-center gap-2 mb-2">
                <MudIcon Icon="@Icons.Material.Filled.FactCheck" Style="color: #a855f7; font-size: 2.2rem;" />
                <MudText Typo="Typo.h4" Class="font-weight-bold" Style="color: #ffffff; letter-spacing: -0.5px;">
                    DTSX Pre-Migration Rules
                </MudText>
            </div>
            <MudText Typo="Typo.body1" Style="color: #cbd5e1; max-width: 750px; line-height: 1.6;">
                Standardized pre-flight checklist and critical validation rules for converting SSIS (<code style="color:#c084fc;">.dtsx</code>) packages to the Modern Data Stack (dbt, Python, Airflow).
            </MudText>
        </div>
        <div class="d-flex align-center gap-3">
            <MudPaper Class="px-4 py-2 text-center rounded-lg" Style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);">
                <MudText Typo="Typo.caption" Style="color: #94a3b8; font-weight:600; text-transform:uppercase; letter-spacing: 0.5px;">Readiness Progress</MudText>
                <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: #38bdf8;">@ProgressPercentage%</MudText>
            </MudPaper>
        </div>
    </div>

    <!-- Progress Bar -->
    <div class="mt-4">
        <div class="d-flex justify-space-between align-center mb-1">
            <MudText Typo="Typo.caption" Style="color: #94a3b8;">Checklist Completion (@CheckedRuleIds.Count of @Rules.Count Rules Verified)</MudText>
            <MudText Typo="Typo.caption" Style="color: #c084fc; font-weight: 700;">@CheckedRuleIds.Count / @Rules.Count</MudText>
        </div>
        <MudProgressLinear Color="Color.Tertiary" Value="@ProgressPercentage" Class="rounded" Style="height: 8px; background: rgba(255,255,255,0.1);" />
    </div>
</div>

<!-- Stats Summary Grid -->
<MudGrid Class="mb-6">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 rounded-lg d-flex align-center gap-4" Style="background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(148, 163, 184, 0.15);">
            <div class="pa-3 rounded-circle d-flex align-center justify-center" Style="background: rgba(168, 85, 247, 0.15);">
                <MudIcon Icon="@Icons.Material.Filled.Rule" Style="color: #c084fc;" />
            </div>
            <div>
                <MudText Typo="Typo.caption" Style="color: #94a3b8; font-weight: 600;">TOTAL RULES</MudText>
                <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: #f8fafc;">@Rules.Count</MudText>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 rounded-lg d-flex align-center gap-4" Style="background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(239, 68, 68, 0.2);">
            <div class="pa-3 rounded-circle d-flex align-center justify-center" Style="background: rgba(239, 68, 68, 0.15);">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" />
            </div>
            <div>
                <MudText Typo="Typo.caption" Style="color: #fca5a5; font-weight: 600;">CRITICAL MANDATORY</MudText>
                <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Error">@Rules.Count(r => r.Severity == SeverityLevel.Critical)</MudText>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 rounded-lg d-flex align-center gap-4" Style="background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(245, 158, 11, 0.2);">
            <div class="pa-3 rounded-circle d-flex align-center justify-center" Style="background: rgba(245, 158, 11, 0.15);">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Warning" />
            </div>
            <div>
                <MudText Typo="Typo.caption" Style="color: #fcd34d; font-weight: 600;">HIGH PRIORITY</MudText>
                <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Warning">@Rules.Count(r => r.Severity == SeverityLevel.High)</MudText>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 rounded-lg d-flex align-center gap-4" Style="background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(56, 189, 248, 0.2);">
            <div class="pa-3 rounded-circle d-flex align-center justify-center" Style="background: rgba(56, 189, 248, 0.15);">
                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" />
            </div>
            <div>
                <MudText Typo="Typo.caption" Style="color: #7dd3fc; font-weight: 600;">MEDIUM PRIORITY</MudText>
                <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Info">@Rules.Count(r => r.Severity == SeverityLevel.Medium)</MudText>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

<!-- Interactive Control Toolbar (Search & Filter) -->
<MudPaper Class="pa-4 mb-6 rounded-lg d-flex align-center justify-space-between flex-wrap gap-4" Style="background: rgba(30, 41, 59, 0.5); border: 1px solid rgba(148, 163, 184, 0.12);">
    <div class="d-flex align-center gap-3 flex-wrap" style="flex: 1; min-width: 280px;">
        <MudTextField @bind-Value="SearchQuery" 
                      Placeholder="Search rules by title, keyword, or rule ID..." 
                      Adornment="Adornment.Start" 
                      AdornmentIcon="@Icons.Material.Filled.Search" 
                      IconSize="Size.Medium" 
                      Variant="Variant.Outlined" 
                      Margin="Margin.Dense" 
                      Immediate="true"
                      Class="flex-grow-1" 
                      Style="background: rgba(15, 23, 42, 0.6);" />
    </div>

    <div class="d-flex align-center gap-2 flex-wrap">
        <MudText Typo="Typo.caption" Style="color: #94a3b8; font-weight: 600;" Class="mr-1">SEVERITY:</MudText>
        <MudChipSet T="string" SelectedChipChanged="OnSeverityFilterChanged">
            <MudChip T="string" Text="All" Color="Color.Default" Variant="@(SelectedSeverityFilter == "All" ? Variant.Filled : Variant.Outlined)" Size="Size.Small">All</MudChip>
            <MudChip T="string" Text="Critical" Color="Color.Error" Variant="@(SelectedSeverityFilter == "Critical" ? Variant.Filled : Variant.Outlined)" Size="Size.Small">Critical</MudChip>
            <MudChip T="string" Text="High" Color="Color.Warning" Variant="@(SelectedSeverityFilter == "High" ? Variant.Filled : Variant.Outlined)" Size="Size.Small">High</MudChip>
            <MudChip T="string" Text="Medium" Color="Color.Info" Variant="@(SelectedSeverityFilter == "Medium" ? Variant.Filled : Variant.Outlined)" Size="Size.Small">Medium</MudChip>
        </MudChipSet>

        <MudSelect T="string" Value="@SelectedCategoryFilter" ValueChanged="OnCategoryFilterChanged" Margin="Margin.Dense" Variant="Variant.Outlined" Dense="true" Style="min-width: 170px; background: rgba(15, 23, 42, 0.6); font-size: 0.85rem;">
            <MudSelectItem Value="@("All")">All Categories</MudSelectItem>
            @foreach (var cat in AllCategories)
            {
                <MudSelectItem Value="@cat">@cat</MudSelectItem>
            }
        </MudSelect>
    </div>
</MudPaper>

<!-- Rules Count Info -->
<div class="d-flex align-center justify-space-between mb-3 px-1">
    <MudText Typo="Typo.body2" Style="color: #94a3b8;">
        Showing <strong style="color: #f1f5f9;">@FilteredRules.Count()</strong> of <strong>@Rules.Count</strong> pre-migration rules
    </MudText>
    @if (CheckedRuleIds.Count > 0)
    {
        <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small" OnClick="ResetChecklist" StartIcon="@Icons.Material.Filled.Refresh">
            Reset Checklist (@CheckedRuleIds.Count verified)
        </MudButton>
    }
</div>

<!-- Modern Rules Cards Accordion -->
<div class="d-flex flex-column gap-3">
    @foreach (var rule in FilteredRules)
    {
        var isChecked = CheckedRuleIds.Contains(rule.Id);
        <MudPaper Class="rounded-lg overflow-hidden transition-all" 
                  Style="@GetRuleCardStyle(rule, isChecked)">
            <MudExpansionPanel Class="modern-rule-panel pa-0" Style="background: transparent;">
                <TitleContent>
                    <div class="d-flex align-center justify-space-between w-100 pr-2 py-1 flex-wrap gap-2">
                        <div class="d-flex align-center gap-3" style="min-width: 300px; flex: 1;">
                            <MudCheckBox T="bool" 
                                         Value="@isChecked" 
                                         ValueChanged="@((val) => ToggleRuleCheck(rule.Id, val))" 
                                         Color="Color.Success" 
                                         StopClickPropagation="true" 
                                         Size="Size.Medium" />
                            <div>
                                <div class="d-flex align-center gap-2 flex-wrap mb-1">
                                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Style="@(isChecked ? "text-decoration: line-through; color: #94a3b8;" : "color: #f8fafc;")">
                                        @rule.Id: @rule.Title
                                    </MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@GetSeverityColor(rule.Severity)" Style="font-weight: 700; font-size: 0.72rem; height: 22px;">
                                        @rule.Severity.ToString().ToUpper()
                                    </MudChip>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="font-size: 0.72rem; height: 22px; color: #cbd5e1; border-color: rgba(203, 213, 225, 0.25);">
                                        @rule.Category
                                    </MudChip>
                                </div>
                                <MudText Typo="Typo.body2" Style="color: #94a3b8; font-size: 0.875rem;">
                                    @rule.ShortSummary
                                </MudText>
                            </div>
                        </div>
                    </div>
                </TitleContent>
                <ChildContent>
                    <div class="pa-4 rounded-b-lg" style="background: rgba(15, 23, 42, 0.6); border-top: 1px solid rgba(148, 163, 184, 0.1);">
                        <MudGrid>
                            <!-- Left Column: Description & Pre-Flight Check -->
                            <MudItem xs="12" md="6">
                                <div class="mb-4">
                                    <div class="d-flex align-center gap-2 mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Style="color: #c084fc;" />
                                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: #e2e8f0;">Description & Rationale</MudText>
                                    </div>
                                    <MudText Typo="Typo.body2" Style="color: #cbd5e1; line-height: 1.6; font-size: 0.875rem;">
                                        @rule.Description
                                    </MudText>
                                </div>

                                <div>
                                    <div class="d-flex align-center gap-2 mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Small" Style="color: #38bdf8;" />
                                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: #e2e8f0;">Verification Steps (Pre-Flight Check)</MudText>
                                    </div>
                                    <div class="pa-3 rounded-lg" style="background: rgba(30, 41, 59, 0.8); border-left: 4px solid #38bdf8; border-top: 1px solid rgba(255,255,255,0.05); border-right: 1px solid rgba(255,255,255,0.05); border-bottom: 1px solid rgba(255,255,255,0.05);">
                                        <MudText Typo="Typo.body2" Style="color: #e2e8f0; font-size: 0.85rem; line-height: 1.5;">
                                            @rule.ChecklistItem
                                        </MudText>
                                    </div>
                                </div>
                            </MudItem>

                            <!-- Right Column: Code Comparison -->
                            <MudItem xs="12" md="6">
                                <!-- Target Standard (Good) -->
                                <div class="mb-3">
                                    <div class="d-flex align-center justify-space-between mb-1">
                                        <div class="d-flex align-center gap-1">
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                                            <MudText Typo="Typo.caption" Class="font-weight-bold" Style="color: #4ade80;">TARGET STANDARD (GOOD PRACTICE)</MudText>
                                        </div>
                                    </div>
                                    <div class="pa-3 rounded-lg font-monospace overflow-x-auto" Style="background: #0f172a; border: 1px solid rgba(74, 222, 128, 0.3); font-size: 0.81rem;">
                                        <pre style="margin: 0; color: #38bdf8; white-space: pre-wrap; font-family: 'JetBrains Mono', 'Fira Code', Consolas, monospace;">@rule.GoodExample</pre>
                                    </div>
                                </div>

                                <!-- Anti-Pattern (Bad) -->
                                <div>
                                    <div class="d-flex align-center justify-space-between mb-1">
                                        <div class="d-flex align-center gap-1">
                                            <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Color="Color.Error" />
                                            <MudText Typo="Typo.caption" Class="font-weight-bold" Style="color: #f87171;">ANTI-PATTERN (MUST AVOID)</MudText>
                                        </div>
                                    </div>
                                    <div class="pa-3 rounded-lg font-monospace overflow-x-auto" Style="background: #0f172a; border: 1px solid rgba(248, 113, 113, 0.3); font-size: 0.81rem;">
                                        <pre style="margin: 0; color: #f87171; white-space: pre-wrap; font-family: 'JetBrains Mono', 'Fira Code', Consolas, monospace;">@rule.BadExample</pre>
                                    </div>
                                </div>
                            </MudItem>
                        </MudGrid>
                    </div>
                </ChildContent>
            </MudExpansionPanel>
        </MudPaper>
    }
</div>

@code {
    public enum SeverityLevel
    {
        Critical,
        High,
        Medium
    }

    private record PreMigrationRule(
        string Id,
        string Title,
        string Category,
        SeverityLevel Severity,
        string ShortSummary,
        string Description,
        string ChecklistItem,
        string GoodExample,
        string BadExample
    );

    private HashSet<string> CheckedRuleIds = new();
    private string SearchQuery = "";
    private string SelectedSeverityFilter = "All";
    private string SelectedCategoryFilter = "All";

    private IEnumerable<string> AllCategories => Rules.Select(r => r.Category).Distinct().OrderBy(c => c);

    private int ProgressPercentage => Rules.Count > 0 ? (int)Math.Round((double)CheckedRuleIds.Count / Rules.Count * 100) : 0;

    private void ToggleRuleCheck(string id, bool isChecked)
    {
        if (isChecked) CheckedRuleIds.Add(id);
        else CheckedRuleIds.Remove(id);
    }

    private void ResetChecklist()
    {
        CheckedRuleIds.Clear();
    }

    private void OnSeverityFilterChanged(MudChip<string> chip)
    {
        if (chip != null && chip.Text != null)
        {
            SelectedSeverityFilter = chip.Text;
        }
    }

    private void OnCategoryFilterChanged(string cat)
    {
        SelectedCategoryFilter = cat;
    }

    private IEnumerable<PreMigrationRule> FilteredRules
    {
        get
        {
            var result = Rules.AsEnumerable();

            if (SelectedSeverityFilter != "All" && Enum.TryParse<SeverityLevel>(SelectedSeverityFilter, out var sev))
            {
                result = result.Where(r => r.Severity == sev);
            }

            if (SelectedCategoryFilter != "All")
            {
                result = result.Where(r => r.Category == SelectedCategoryFilter);
            }

            if (!string.IsNullOrWhiteSpace(SearchQuery))
            {
                var q = SearchQuery.Trim();
                result = result.Where(r =>
                    r.Id.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    r.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    r.ShortSummary.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    r.Description.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    r.Category.Contains(q, StringComparison.OrdinalIgnoreCase)
                );
            }

            return result;
        }
    }

    private Color GetSeverityColor(SeverityLevel severity) => severity switch
    {
        SeverityLevel.Critical => Color.Error,
        SeverityLevel.High => Color.Warning,
        SeverityLevel.Medium => Color.Info,
        _ => Color.Default
    };

    private string GetRuleCardStyle(PreMigrationRule rule, bool isChecked)
    {
        var borderAccent = rule.Severity switch
        {
            SeverityLevel.Critical => "rgba(239, 68, 68, 0.4)",
            SeverityLevel.High => "rgba(245, 158, 11, 0.4)",
            SeverityLevel.Medium => "rgba(56, 189, 248, 0.4)",
            _ => "rgba(148, 163, 184, 0.2)"
        };

        if (isChecked)
        {
            return "background: rgba(15, 23, 42, 0.4); border: 1px solid rgba(74, 222, 128, 0.3); opacity: 0.85;";
        }

        return $"background: rgba(30, 41, 59, 0.6); border: 1px solid {borderAccent}; backdrop-filter: blur(8px);";
    }

    private List<PreMigrationRule> Rules = new()
    {
        new(
            "RULE-01",
            "Self-Healing Staging Tables (CREATE TABLE IF NOT EXISTS)",
            "Staging & Storage",
            SeverityLevel.Critical,
            "Ensure Airflow extraction scripts automatically create staging table DDL structures if they do not exist.",
            "When extracting data from source systems to staging databases (e.g. PostgreSQL, Snowflake), Python scripts or Airflow tasks must guarantee that staging table DDL structures are created automatically. Without self-healing DDLs, DAG runs will immediately fail on first execution in new environments.",
            "Verify Python extraction scripts and truncate_staging tasks in Airflow DAGs to confirm 'CREATE TABLE IF NOT EXISTS' DDL statements precede the extraction step.",
            "CREATE TABLE IF NOT EXISTS stg_hr_employees (\n    employee_id INT PRIMARY KEY,\n    first_name VARCHAR(50),\n    salary NUMERIC(12,2)\n);",
            "INSERT INTO stg_hr_employees SELECT ...;\n-- Assumes staging tables were manually pre-created in DB."
        ),
        new(
            "RULE-02",
            "Extraction Idempotency & Clean-Before-Insert (Truncate Staging)",
            "Staging & Storage",
            SeverityLevel.Critical,
            "Execute TRUNCATE / staging cleanup before insertion to prevent Primary Key duplicates during DAG retries.",
            "Airflow DAGs are engineered to be safely retried at any time (idempotent). If an extraction task inserts data into staging tables without pre-clearing existing rows, task retries will trigger 'duplicate key value violates unique constraint' errors or duplicate data.",
            "Ensure every data ingestion task targeting staging begins with 'TRUNCATE TABLE' or an equivalent idempotent cleanup operation.",
            "TRUNCATE TABLE stg_sales_transactions;\nINSERT INTO stg_sales_transactions SELECT ...;",
            "INSERT INTO stg_sales_transactions SELECT ...;\n-- No TRUNCATE execution, causing Primary Key constraint errors on DAG retry."
        ),
        new(
            "RULE-03",
            "Connection Manager Scope Validation & Multi-Source References",
            "Connections & Security",
            SeverityLevel.Critical,
            "Audit all .conmgr files (Project vs Package level) and map them to official Airflow Connections.",
            "SSIS packages frequently utilize Project or Package level Connection Managers pointing to multiple isolated databases (e.g., HR_PayrollSystem, CoreBankingLedger). Connections must never be hardcoded to local connection strings or default fallback databases.",
            "Audit all .conmgr files in the SSIS solution, then register these connections in Airflow Connection Manager (e.g., Airflow PostgresHook / pyodbc connections).",
            "from airflow.providers.postgres.hooks.postgres import PostgresHook\n\nhook = PostgresHook(postgres_conn_id='hr_source_db')\nengine = hook.get_sqlalchemy_engine()",
            "conn_str = 'Driver={SQL Server};Server=192.168.1.100;Database=SsisDemoDB;'\n# Invalid hardcoded connection string & fallback database"
        ),
        new(
            "RULE-04",
            "dbt Lookup Column Attribution via CTE Joins (Not source_data)",
            "dbt & Transformation",
            SeverityLevel.High,
            "SSIS Lookup output columns must be referenced from their respective CTE Lookup aliases, not source_data.",
            "When migrating SSIS Lookup Transformations to dbt SQL, lookup table attributes are joined via CTE LEFT JOINs. A common automated conversion bug is attributing lookup columns to the 'source_data' alias, which triggers dbt compilation errors ('column does not exist').",
            "Run Quality Gate validation on the SSIS Code Migrator to confirm that all lookup columns correctly reference their joined lookup CTE (e.g., lkp_dept.department_name).",
            "WITH source_data AS (\n    SELECT employee_id, dept_id FROM {{ source('hr', 'emp') }}\n),\nlkp_dept AS (\n    SELECT dept_id, dept_name FROM {{ ref('stg_departments') }}\n)\nSELECT s.employee_id, d.dept_name -- Correct lookup CTE reference\nFROM source_data s\nLEFT JOIN lkp_dept d ON s.dept_id = d.dept_id",
            "SELECT source_data.employee_id, source_data.dept_name -- Incorrect! dept_name does not exist in source_data"
        ),
        new(
            "RULE-05",
            "Standardization of SSIS Expressions to ANSI SQL",
            "dbt & Transformation",
            SeverityLevel.High,
            "Convert SSIS Expressions (ISNULL, FINDSTRING, GETDATE) to standard ANSI SQL functions (COALESCE, POSITION, CURRENT_TIMESTAMP).",
            "SSIS Derived Column components often contain C#-like / SSIS expression syntax that is invalid in ANSI SQL dialects. Before migrating logic into dbt models, expressions must be transformed into standard ANSI SQL functions.",
            "Inspect Derived Column nodes in .dtsx XML files and ensure functions like ISNULL(), GETDATE(), and SUBSTRING() (1-based index) match the target SQL dialect.",
            "SELECT COALESCE(bonus_amount, 0) AS net_bonus,\n       CURRENT_TIMESTAMP AS loaded_at\nFROM source_data",
            "SELECT ISNULL(bonus_amount) ? 0 : bonus_amount AS net_bonus, GETDATE() AS loaded_at\n-- Unsupported SSIS expression syntax in modern SQL engines"
        ),
        new(
            "RULE-06",
            "Decoupling Script Components (C# / VB.NET) to Python / PySpark",
            "Script Tasks & Code",
            SeverityLevel.High,
            "Refactor C# code within Script Tasks/Components into standalone Python functions in Airflow.",
            "C#/VB.NET code inside SSIS Script Tasks cannot run natively on Linux-based Airflow workers. Custom business logic such as file processing, REST API calls, or encryption must be refactored into Python scripts or PySpark DataFrames.",
            "Identify all ScriptTask & ScriptComponent nodes in the SSIS package, then build separate Python modules invoked via PythonOperator or BashOperator.",
            "# Airflow Python Task\ndef process_custom_file(**kwargs):\n    import requests\n    resp = requests.get('https://api.internal/data')\n    # Ingest payload to staging table",
            "// SSIS C# Script Task Code\npublic void Main() {\n    System.Net.WebClient client = new System.Net.WebClient();\n    // Attempting to run Windows DLLs on Linux Airflow will fail\n}"
        ),
        new(
            "RULE-07",
            "Parent-Child Package Dependency Mapping (Execute Package Task)",
            "Orchestration",
            SeverityLevel.High,
            "Use TriggerDagRunOperator or combine child packages into Sub-DAGs / Task Groups.",
            "Master SSIS packages frequently invoke sub-packages via Execute Package Tasks. When migrated to Airflow, these relationships must be mapped using TriggerDagRunOperator to preserve strict execution ordering.",
            "Review Master ETL Orchestration packages (e.g. Pkg_00_Master_ETL_Orchestration.dtsx) and verify DAG dependencies are explicitly chained (dag_master >> trigger_child_dag).",
            "trigger_pkg_01 = TriggerDagRunOperator(\n    task_id='trigger_pkg_01',\n    trigger_dag_id='pkg_01_load_dimensions',\n    wait_for_completion=True\n)",
            "# Creating disconnected DAGs for each sub-package without parent Orchestration DAG"
        ),
        new(
            "RULE-08",
            "Package Parameter & Environment Variable Mapping to Airflow Templating",
            "Connections & Security",
            SeverityLevel.Medium,
            "Map @[$Package::Param] and .dtsConfig files to Airflow Variables & Params ({{ params.x }}).",
            "SSIS packages rely on SSISDB Package Parameters and .dtsConfig files for dynamic configuration (cutoff dates, target environments). In Airflow, these parameters are migrated to DAG params or Airflow Variables.",
            "Extract all SSIS package parameters and define structured parameter schemas inside the Airflow DAG definition.",
            "with DAG(dag_id='etl_dag', params={'start_date': Param('2026-01-01', type='string')}):\n    # Inside task: select * from table where date >= '{{ params.start_date }}'",
            "-- Hardcoded date literals in SQL query files without parameterization"
        ),
        new(
            "RULE-09",
            "Precedence Constraint & Failure Handling Strategy",
            "Orchestration",
