@page "/modernization-guide"
@using MudBlazor

<PageTitle>SSIS Modernization Guide — SSIS Lineage Hub</PageTitle>

<div class="mb-4 d-flex align-center justify-space-between flex-wrap gap-4">
    <div>
        <MudText Typo="Typo.h5" Class="d-flex align-center gap-2 font-weight-bold">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Color="Color.Tertiary" Size="Size.Large" />
            Modernization Knowledge Base
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Comprehensive guidelines and pre-migration rules for migrating SSIS (.dtsx) packages to the Modern Data Stack (dbt, Python, Airflow).
        </MudText>
    </div>
    <div class="d-flex gap-2">
        <MudChip T="string" Color="Color.Tertiary" Variant="Variant.Filled" Style="font-weight:700;">STRATEGY 2026</MudChip>
        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Style="font-weight:700;">10 PRE-MIGRATION RULES</MudChip>
    </div>
</div>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToPanels="true" PanelClass="pa-4" Class="mt-6">
    <MudTabPanel Text="Executive Summary" Icon="@Icons.Material.Filled.Assessment">
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.h6" Class="mb-4 font-weight-bold">SSIS Modernization Journey 2026</MudText>
                <MudText Typo="Typo.body1" Class="mb-4" Style="line-height: 1.6;">
                    The legacy SQL Server Integration Services (SSIS) architecture is being phased out in favor of a Modern Data Stack. 
                    This shift brings version control, CI/CD, isolated testing, and scalable orchestration to our data engineering workflows.
                </MudText>
                
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    <strong>Core Directive:</strong> We are executing an incremental migration. SQL Server remains our primary database, but orchestration moves to Apache Airflow and transformation moves to dbt.
                </MudAlert>

                <MudText Typo="Typo.subtitle1" Class="mt-6 mb-2 font-weight-bold">Key Benefits</MudText>
                <MudList T="string">
                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">SQL-First Transformations via dbt Models</MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">Python-based Extraction & Loading (Pandas/PySpark)</MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">Robust Orchestration & Scheduling with Apache Airflow</MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">Full Git Integration & CI/CD Pipelines</MudListItem>
                </MudList>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4" Style="background: rgba(168, 85, 247, 0.05); border: 1px solid rgba(168, 85, 247, 0.2);">
                    <MudText Typo="Typo.subtitle2" Class="mb-2 font-weight-bold color-tertiary">Quick Links</MudText>
                    <MudButton Href="/ssis-migrator" Variant="Variant.Text" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Transform" Class="mb-2 w-100 justify-start">
                        Go to SSIS Code Migrator
                    </MudButton>
                    <MudButton Href="/lineage" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AccountTree" Class="w-100 justify-start">
                        Go to Lineage Discovery
                    </MudButton>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="Aturan Pre-Migrasi DTSX" Icon="@Icons.Material.Filled.FactCheck">
        <div class="mb-4 d-flex justify-space-between align-center flex-wrap gap-4">
            <div>
                <MudText Typo="Typo.h6" Class="font-weight-bold">Aturan & Panduan Penting Sebelum Migrasi DTSX</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Checklist & standar wajib yang harus diperhatikan dan divalidasi sebelum mengonversi paket SSIS (.dtsx) ke Airflow & dbt.
                </MudText>
            </div>
            <div class="d-flex align-center gap-3">
                <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">Critical: @Rules.Count(r => r.Severity == SeverityLevel.Critical)</MudChip>
                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">High: @Rules.Count(r => r.Severity == SeverityLevel.High)</MudChip>
                <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled">Medium: @Rules.Count(r => r.Severity == SeverityLevel.High)</MudChip>
            </div>
        </div>

        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3 text-center" Style="border: 1px solid var(--mud-palette-lines-default);">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">TOTAL RULES</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold color-tertiary">@Rules.Count</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3 text-center" Style="border: 1px solid var(--mud-palette-lines-default);">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">CRITICAL MANDATORY</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Error">@Rules.Count(r => r.Severity == SeverityLevel.Critical)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3 text-center" Style="border: 1px solid var(--mud-palette-lines-default);">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">HIGH PRIORITY</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Warning">@Rules.Count(r => r.Severity == SeverityLevel.High)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3 text-center" Style="border: 1px solid var(--mud-palette-lines-default);">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">VERIFIED CHECKLIST</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Success">@CheckedRuleIds.Count / @Rules.Count</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <div class="d-flex align-center gap-2 mb-4">
            <MudText Typo="Typo.body2" Class="font-weight-bold">Filter Severity:</MudText>
            <MudChipSet T="string" SelectedChipChanged="OnFilterChanged">
                <MudChip T="string" Text="All" Color="Color.Default" Variant="@(SelectedSeverityFilter == "All" ? Variant.Filled : Variant.Outlined)">All (@Rules.Count)</MudChip>
                <MudChip T="string" Text="Critical" Color="Color.Error" Variant="@(SelectedSeverityFilter == "Critical" ? Variant.Filled : Variant.Outlined)">Critical</MudChip>
                <MudChip T="string" Text="High" Color="Color.Warning" Variant="@(SelectedSeverityFilter == "High" ? Variant.Filled : Variant.Outlined)">High</MudChip>
                <MudChip T="string" Text="Medium" Color="Color.Info" Variant="@(SelectedSeverityFilter == "Medium" ? Variant.Filled : Variant.Outlined)">Medium</MudChip>
            </MudChipSet>
        </div>

        <MudExpansionPanels MultiExpansion="true" Elevation="1">
            @foreach (var rule in FilteredRules)
            {
                var isChecked = CheckedRuleIds.Contains(rule.Id);
                <MudExpansionPanel Class="mb-2" Style="border: 1px solid var(--mud-palette-lines-default); border-radius: 8px;">
                    <TitleContent>
                        <div class="d-flex align-center justify-space-between w-100 pr-4">
                            <div class="d-flex align-center gap-3">
                                <MudCheckBox T="bool" Value="@isChecked" ValueChanged="@((val) => ToggleRuleCheck(rule.Id, val))" Color="Color.Success" StopClickPropagation="true" />
                                <div>
                                    <div class="d-flex align-center gap-2">
                                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Style="@(isChecked ? "text-decoration: line-through; opacity: 0.7;" : "")">
                                            @rule.Id: @rule.Title
                                        </MudText>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@GetSeverityColor(rule.Severity)">
                                            @rule.Severity.ToString().ToUpper()
                                        </MudChip>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                            @rule.Category
                                        </MudChip>
                                    </div>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        @rule.ShortSummary
                                    </MudText>
                                </div>
                            </div>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        <MudDivider Class="my-2" />
                        <MudGrid Class="pa-2">
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-1 color-tertiary">Deskripsi & Potensi Risiko</MudText>
                                <MudText Typo="Typo.body2" Class="mb-3" Style="line-height: 1.6;">
                                    @rule.Description
                                </MudText>

                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-1 color-tertiary">Langkah Verifikasi (Pre-Flight Check)</MudText>
                                <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Class="pa-2">
                                    <MudText Typo="Typo.body2">@rule.ChecklistItem</MudText>
                                </MudAlert>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-1 text-success">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" /> Standar Target (Good Practice)
                                </MudText>
                                <MudPaper Class="pa-2 mb-3 font-monospace" Style="background: #1e293b; color: #38bdf8; font-size: 0.82rem; overflow-x: auto;">
                                    <pre style="margin:0;">@rule.GoodExample</pre>
                                </MudPaper>

                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-1 text-danger">
                                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Class="mr-1" /> Praktik yang Harus Dihindari (Anti-Pattern)
                                </MudText>
                                <MudPaper Class="pa-2 font-monospace" Style="background: #1e293b; color: #f87171; font-size: 0.82rem; overflow-x: auto;">
                                    <pre style="margin:0;">@rule.BadExample</pre>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudTabPanel>

    <MudTabPanel Text="Target Architecture" Icon="@Icons.Material.Filled.Architecture">
        <MudText Typo="Typo.h6" Class="mb-4 font-weight-bold">The Modern Data Stack (MDS)</MudText>
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudCard Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default);">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">1. Orchestration</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudIcon Icon="@Icons.Material.Filled.Air" Color="Color.Primary" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2">
                            <strong>Apache Airflow</strong> replaces SQL Server Agent and SSIS Control Flow. Airflow DAGs will trigger extraction scripts, dbt runs, and manage dependencies.
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudCard Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default);">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">2. Ingestion / E & L</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudIcon Icon="@Icons.Material.Filled.Code" Color="Color.Secondary" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2">
                            <strong>Python (pyodbc/pandas)</strong> replaces SSIS Source/Destination components for moving raw data from sources into the Staging area.
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudCard Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default);">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">3. Transformation</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudIcon Icon="@Icons.Material.Filled.Layers" Color="Color.Warning" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2">
                            <strong>dbt (data build tool)</strong> replaces SSIS Data Flow Transformations (Derived Column, Lookup, Aggregate). Transformations are written in SQL and materialized as views/tables.
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="SSIS Component Mapping" Icon="@Icons.Material.Filled.Map">
        <MudText Typo="Typo.h6" Class="mb-4 font-weight-bold">How to Map SSIS Elements to the New Stack</MudText>
        
        <MudTable Items="@ComponentMappings" Hover="true" Dense="true" Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default);">
            <HeaderContent>
                <MudTh>SSIS Component</MudTh>
                <MudTh>Modern Equivalent</MudTh>
                <MudTh>Implementation Notes</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="SSIS Component">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.Ssis</MudChip>
                </MudTd>
                <MudTd DataLabel="Modern Equivalent">
                    <strong>@context.Modern</strong>
                </MudTd>
                <MudTd DataLabel="Notes">@context.Notes</MudTd>
            </RowTemplate>
        </MudTable>
    </MudTabPanel>

    <MudTabPanel Text="Migration Workflow" Icon="@Icons.Material.Filled.Timeline">
        <MudText Typo="Typo.h6" Class="mb-4 font-weight-bold">Step-by-Step Migration Process</MudText>
        <MudTimeline>
            <MudTimelineItem Color="Color.Primary" Variant="Variant.Filled">
                <ItemContent>
                    <MudCard Elevation="0" Class="pa-4 mb-4" Style="border: 1px solid var(--mud-palette-lines-default);">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">1. Assessment & Lineage Analysis</MudText>
                        <MudText Typo="Typo.body2">Use the <strong>Lineage Discovery</strong> tool to parse the legacy .dtsx package. Understand the dependencies, column-level lineage, and execution flow.</MudText>
                    </MudCard>
                </ItemContent>
            </MudTimelineItem>
            <MudTimelineItem Color="Color.Secondary" Variant="Variant.Filled">
                <ItemContent>
                    <MudCard Elevation="0" Class="pa-4 mb-4" Style="border: 1px solid var(--mud-palette-lines-default);">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">2. Code Skeleton Generation</MudText>
                        <MudText Typo="Typo.body2">Use the <strong>SSIS Code Migrator</strong> to automatically generate the baseline dbt models and Airflow DAGs for the target package.</MudText>
                    </MudCard>
                </ItemContent>
            </MudTimelineItem>
            <MudTimelineItem Color="Color.Warning" Variant="Variant.Filled">
                <ItemContent>
                    <MudCard Elevation="0" Class="pa-4 mb-4" Style="border: 1px solid var(--mud-palette-lines-default);">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">3. Transformation Implementation (dbt)</MudText>
                        <MudText Typo="Typo.body2">Refine the generated dbt models. Implement complex business logic using CTEs (Common Table Expressions) and dbt macros.</MudText>
                    </MudCard>
                </ItemContent>
            </MudTimelineItem>
            <MudTimelineItem Color="Color.Tertiary" Variant="Variant.Filled">
                <ItemContent>
                    <MudCard Elevation="0" Class="pa-4 mb-4" Style="border: 1px solid var(--mud-palette-lines-default);">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">4. Orchestration & Testing (Airflow)</MudText>
                        <MudText Typo="Typo.body2">Deploy the Airflow DAG. Run data quality tests (using dbt test or Great Expectations) in parallel with legacy SSIS to ensure parity.</MudText>
                    </MudCard>
                </ItemContent>
            </MudTimelineItem>
        </MudTimeline>
    </MudTabPanel>
</MudTabs>

@code {
    private record ComponentMap(string Ssis, string Modern, string Notes);

    public enum SeverityLevel
    {
        Critical,
        High,
        Medium
    }

    private record PreMigrationRule(
        string Id,
        string Title,
        string Category,
        SeverityLevel Severity,
        string ShortSummary,
        string Description,
        string ChecklistItem,
        string GoodExample,
        string BadExample
    );

    private HashSet<string> CheckedRuleIds = new();
    private string SelectedSeverityFilter = "All";

    private void ToggleRuleCheck(string id, bool isChecked)
    {
        if (isChecked) CheckedRuleIds.Add(id);
        else CheckedRuleIds.Remove(id);
    }

    private void OnFilterChanged(MudChip<string> chip)
    {
        if (chip != null)
        {
            SelectedSeverityFilter = chip.Text;
        }
    }

    private IEnumerable<PreMigrationRule> FilteredRules => SelectedSeverityFilter switch
    {
        "Critical" => Rules.Where(r => r.Severity == SeverityLevel.Critical),
        "High" => Rules.Where(r => r.Severity == SeverityLevel.High),
        "Medium" => Rules.Where(r => r.Severity == SeverityLevel.Medium),
        _ => Rules
    };

    private Color GetSeverityColor(SeverityLevel severity) => severity switch
    {
        SeverityLevel.Critical => Color.Error,
        SeverityLevel.High => Color.Warning,
        SeverityLevel.Medium => Color.Info,
        _ => Color.Default
    };

    private List<PreMigrationRule> Rules = new()
    {
        new(
            "RULE-01",
            "Self-Healing Staging Tables (CREATE TABLE IF NOT EXISTS)",
            "Staging & Storage",
            SeverityLevel.Critical,
            "Pastikan script ekstraksi Airflow membuat tabel staging secara otomatis jika belum ada.",
            "Saat melakukan ekstraksi data dari sumber ke database staging (seperti PostgreSQL/Snowflake), script Python atau task Airflow harus memastikan struktur DDL tabel staging dibuat otomatis jika belum ada. Tanpa DDL self-healing, DAG akan langsung gagal pada run pertama di lingkungan baru.",
            "Periksa skrip ekstraksi Python dan task truncate_staging pada Airflow DAG untuk memastikan terdapat DDL 'CREATE TABLE IF NOT EXISTS' sebelum proses ekstraksi berjalan.",
            "CREATE TABLE IF NOT EXISTS stg_hr_employees (\n    employee_id INT PRIMARY KEY,\n    first_name VARCHAR(50),\n    salary NUMERIC(12,2)\n);",
            "INSERT INTO stg_hr_employees SELECT ...;\n-- Mengasumsikan tabel staging sudah dibuat manual di DB."
        ),
        new(
            "RULE-02",
            "Idempotensi Ekstraksi & Clean-Before-Insert (Truncate Staging)",
            "Staging & Storage",
            SeverityLevel.Critical,
            "Lakukan TRUNCATE / pembersihan staging sebelum insert untuk mencegah duplikasi Primary Key saat retry.",
            "Airflow DAG dirancang untuk dapat diretry kapan saja secara aman (idempotent). Jika task ekstraksi memasukkan data ke tabel staging tanpa pembersihan terlebih dahulu, percobaan ulang (retry) akan menyebabkan error 'duplicate key value violates unique constraint' atau data ganda.",
            "Pastikan setiap task penarikan data ke staging diawali dengan 'TRUNCATE TABLE' atau operasi pembersihan idempotent yang relevan.",
            "TRUNCATE TABLE stg_sales_transactions;\nINSERT INTO stg_sales_transactions SELECT ...;",
            "INSERT INTO stg_sales_transactions SELECT ...;\n-- Tanpa TRUNCATE terlebih dahulu, memicu Primary Key constraint error saat DAG retry."
        ),
        new(
            "RULE-03",
            "Validasi Scope Connection Manager & Referensi Multi-Source DB",
            "Connections & Security",
            SeverityLevel.Critical,
            "Audit seluruh .conmgr (Project vs Package level) dan petakan ke Airflow Connections resmi.",
            "Paket SSIS sering menggunakan Connection Manager tingkat Project atau Package yang menunjuk ke beberapa database terpisah (misal: HR_PayrollSystem, CoreBankingLedger). Koneksi ini tidak boleh di-hardcode ke string koneksi lokal atau menggunakan database default fallback.",
            "Audit semua file .conmgr pada solusi SSIS, lalu daftarkan koneksi tersebut di Airflow Connection Manager (misal: Airflow PostgresHook / pyodbc connections).",
            "from airflow.providers.postgres.hooks.postgres import PostgresHook\n\nhook = PostgresHook(postgres_conn_id='hr_source_db')\nengine = hook.get_sqlalchemy_engine()",
            "conn_str = 'Driver={SQL Server};Server=192.168.1.100;Database=SsisDemoDB;'\n# Hardcoded connection string & database fallback salah"
        ),
        new(
            "RULE-04",
            "Atribusi Kolom Lookup dbt via CTE Join (Bukan source_data)",
            "dbt & Transformation",
            SeverityLevel.High,
            "Kolom hasil SSIS Lookup harus di-referensikan dari alias CTE Lookup, bukan source_data.",
            "Dalam migrasi Lookup Transformation SSIS ke dbt SQL, data dari tabel lookup dipetakan melalui LEFT JOIN CTE. Error umum pada konverter otomatis adalah mengaitkan kolom hasil lookup ke alias 'source_data', yang menyebabkan error dbt compile 'column does not exist'.",
            "Jalankan Quality Gate validation pada SSIS Code Migrator untuk mengonfirmasi bahwa semua kolom lookup dirujuk dengan benar ke CTE lookup terkait (misal: lkp_dept.department_name).",
            "WITH source_data AS (\n    SELECT employee_id, dept_id FROM {{ source('hr', 'emp') }}\n),\nlkp_dept AS (\n    SELECT dept_id, dept_name FROM {{ ref('stg_departments') }}\n)\nSELECT s.employee_id, d.dept_name -- Correct lookup CTE reference\nFROM source_data s\nLEFT JOIN lkp_dept d ON s.dept_id = d.dept_id",
            "SELECT source_data.employee_id, source_data.dept_name -- Salah! dept_name tidak ada di source_data"
        ),
        new(
            "RULE-05",
            "Standarisasi Ekspresi SSIS ke ANSI SQL Standard",
            "dbt & Transformation",
            SeverityLevel.High,
            "Konversi SSIS Expression (ISNULL, FINDSTRING, GETDATE) ke fungsi SQL standar (COALESCE, POSITION, CURRENT_TIMESTAMP).",
            "Komponen Derived Column pada SSIS sering memuat ekspresi C#-like / SSIS expression syntax yang tidak valid di ANSI SQL. Sebelum memindahkan logika ke model dbt, ekspresi harus ditransformasikan ke fungsi ANSI SQL.",
            "Periksa node Derived Column pada .dtsx XML dan pastikan fungsi seperti ISNULL(), GETDATE(), dan SUBSTRING() (index 1) disesuaikan dengan dialect SQL target.",
            "SELECT COALESCE(bonus_amount, 0) AS net_bonus,\n       CURRENT_TIMESTAMP AS loaded_at\nFROM source_data",
            "SELECT ISNULL(bonus_amount) ? 0 : bonus_amount AS net_bonus, GETDATE() AS loaded_at\n-- SSIS expression syntax yang tidak didukung SQL engine"
        ),
        new(
            "RULE-06",
            "Dekopling Script Component (C# / VB.NET) ke Script Python / PySpark",
            "Script Tasks & Code",
            SeverityLevel.High,
            "Refaktor kode C# pada Script Task/Component menjadi fungsi Python mandiri di Airflow.",
            "Kode C#/VB.NET di dalam Script Task SSIS tidak dapat dijalankan secara native di Linux worker Airflow. Logika bisnis seperti pemrosesan file khusus, panggilan REST API, atau enkripsi harus direfaktor menjadi Python script atau PySpark DataFrame.",
