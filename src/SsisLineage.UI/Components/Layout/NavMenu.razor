@using Microsoft.AspNetCore.Components.Routing

<MudNavMenu Class="modern-nav-menu px-2">
    <div class="px-4 py-2">
        <MudText Typo="Typo.overline" Style="font-size: 0.75rem; font-weight: 700; color: var(--mud-palette-text-secondary); letter-spacing: 1px;">DISCOVERY</MudText>
    </div>
    <MudNavLink Href="lineage" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountTree" Class="modern-nav-link mb-1">
        Lineage Discovery
    </MudNavLink>
    <MudNavLink Href="lineage-trace" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Search" Class="modern-nav-link mb-1">
        Lineage Search
    </MudNavLink>
    <MudNavLink Href="detailed-report" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Description" Class="modern-nav-link mb-3">
        Detailed Report
    </MudNavLink>

    <div class="px-4 py-2">
        <MudText Typo="Typo.overline" Style="font-size: 0.75rem; font-weight: 700; color: var(--mud-palette-text-secondary); letter-spacing: 1px;">ANALYSIS</MudText>
    </div>
    <MudNavLink Href="ssis-inspector" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.HealthAndSafety" Class="modern-nav-link mb-1">
        <div class="d-flex align-center gap-2">
            <span>SSIS Inspector</span>
            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
                     Style="height:16px; font-size:0.6rem; padding:0 5px; border-radius:4px;">PRO</MudChip>
        </div>
    </MudNavLink>
    <MudNavLink Href="what-if" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Science" Class="modern-nav-link mb-1">
        <div class="d-flex align-center gap-2">
            <span>What-If Simulator</span>
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                     Style="height:16px; font-size:0.6rem; padding:0 5px; border-radius:4px;">NEW</MudChip>
        </div>
    </MudNavLink>
    <MudNavLink Href="nl-query" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Psychology" Class="modern-nav-link mb-1">
        <div class="d-flex align-center gap-2">
            <span>NL Query Engine</span>
            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                     Style="height:16px; font-size:0.6rem; padding:0 5px; border-radius:4px;">NEW</MudChip>
        </div>
    </MudNavLink>
    <MudNavLink Href="risk-heatmap" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.LocalFireDepartment" Class="modern-nav-link mb-1">
        <div class="d-flex align-center gap-2">
            <span>Risk Scorer & Heatmap</span>
            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                     Style="height:16px; font-size:0.6rem; padding:0 5px; border-radius:4px;">NEW</MudChip>
        </div>
    </MudNavLink>
    <MudNavLink Href="quality-propagation" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReportProblem" Class="modern-nav-link mb-1">
        <div class="d-flex align-center gap-2">
            <span>Quality Propagation</span>
            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                     Style="height:16px; font-size:0.6rem; padding:0 5px; border-radius:4px;">NEW</MudChip>
        </div>
    </MudNavLink>
    <MudNavLink Href="data-contracts" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Description" Class="modern-nav-link mb-1">
        <div class="d-flex align-center gap-2">
            <span>Data Contracts</span>
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                     Style="height:16px; font-size:0.6rem; padding:0 5px; border-radius:4px;">NEW</MudChip>
        </div>
    </MudNavLink>
</MudNavMenu>
